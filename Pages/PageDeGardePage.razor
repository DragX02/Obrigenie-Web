@page "/page-de-garde"
@page "/page-de-garde/{Id:int}"

@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="garde-page">

    <div class="garde-menu">
        <a href="/pages-de-garde" class="garde-retour">← Modèles</a>
        <h2 class="garde-title">Page de garde</h2>

        @if (chargement)
        {
            <div class="garde-label">Chargement…</div>
        }
        else
        {
            <button class="garde-menu-item @(menuOuvert == "feuille" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("feuille")'>
                📄 Feuille
                <span class="garde-fleche">@(menuOuvert == "feuille" ? "▾" : "▸")</span>
            </button>

            @if (menuOuvert == "feuille")
            {
                <div class="garde-options">
                    <label class="garde-label">Orientation</label>
                    <label class="garde-check">
                        <input type="radio" name="orientation" checked="@(d.Orientation == "portrait")" @onchange='() => d.Orientation = "portrait"' />
                        Portrait
                    </label>
                    <label class="garde-check">
                        <input type="radio" name="orientation" checked="@(d.Orientation == "paysage")" @onchange='() => d.Orientation = "paysage"' />
                        Paysage
                    </label>
                </div>
            }

            <button class="garde-menu-item @(menuOuvert == "textes" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("textes")'>
                🔤 Textes
                <span class="garde-fleche">@(menuOuvert == "textes" ? "▾" : "▸")</span>
            </button>

            @if (menuOuvert == "textes")
            {
                <div class="garde-options">
                    <label class="garde-label">Ajouter</label>
                    <div class="garde-ajout-textes">
                        <button class="garde-petit-btn" @onclick='() => AjouterTexte("Titre", 40, 150)'>+ Titre</button>
                        <button class="garde-petit-btn" @onclick='() => AjouterTexte("Nom Prénom", 22, 420)'>+ Nom Prénom</button>
                        <button class="garde-petit-btn" @onclick='() => AjouterTexte("Année 2026-2027", 18, 470)'>+ Année</button>
                        <button class="garde-petit-btn" @onclick='() => AjouterTexte("Texte", 18, 300)'>+ Texte libre</button>
                    </div>

                    @if (d.Textes.Count > 0)
                    {
                        <label class="garde-label">Zones de texte</label>
                        @foreach (var t in d.Textes)
                        {
                            var zone = t;
                            <button class="garde-zone-ligne @(zoneChoisie == zone ? "garde-zone-ligne-actif" : "")" @onclick="() => ChoisirTexte(zone)">
                                @(zone.Texte == "" ? "(vide)" : zone.Texte)
                            </button>
                        }
                    }

                    @if (zoneChoisie != null)
                    {
                        <div class="garde-section-title">Zone choisie</div>

                        <label class="garde-label">Texte</label>
                        <textarea class="garde-input" rows="2" @bind="zoneChoisie.Texte" @bind:event="oninput"></textarea>

                        <label class="garde-label">Police</label>
                        <select class="garde-input" @bind="zoneChoisie.Police" style="font-family:@zoneChoisie.Police;">
                            @foreach (var p in polices)
                            {
                                <option value="@p" style="font-family:@p;">@p</option>
                            }
                        </select>

                        <label class="garde-label">Taille : @zoneChoisie.Taille px</label>
                        <input type="range" min="8" max="120" @bind="zoneChoisie.Taille" @bind:event="oninput" />

                        <label class="garde-label">Couleur</label>
                        <input type="color" class="garde-color" @bind="zoneChoisie.Couleur" @bind:event="oninput" />

                        <div class="garde-ajout-textes">
                            <label class="garde-check">
                                <input type="checkbox" @bind="zoneChoisie.Gras" />
                                Gras
                            </label>
                            <label class="garde-check">
                                <input type="checkbox" @bind="zoneChoisie.Italique" />
                                Italique
                            </label>
                        </div>

                        <label class="garde-label">Placement : glisse le texte sur la feuille</label>
                        <div class="garde-ajout-textes">
                            <button class="garde-petit-btn" @onclick="CentrerTexte">↔ Centrer</button>
                            <button class="garde-petit-btn garde-btn-supprimer" @onclick="SupprimerTexte">🗑 Supprimer</button>
                        </div>
                    }
                </div>
            }

            <button class="garde-menu-item @(menuOuvert == "images" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("images")'>
                🖼️ Images
                <span class="garde-fleche">@(menuOuvert == "images" ? "▾" : "▸")</span>
            </button>

            @if (menuOuvert == "images")
            {
                <div class="garde-options">
                    <label class="garde-label">Catégorie</label>
                    <select class="garde-input" @bind="categorieImage" @bind:after="ChargerMiniatures">
                        <option value="Toutes">Toutes</option>
                        @foreach (var c in CategoriesImages())
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <input class="garde-input" @bind="rechercheImage" @bind:event="oninput" @bind:after="ChargerMiniatures" placeholder="Rechercher une image" />

                    @if (chargementImages)
                    {
                        <div class="garde-label">Chargement des images…</div>
                    }
                    else if (ImagesAffichees().Count == 0)
                    {
                        <div class="garde-label">Aucune image.</div>
                    }
                    else
                    {
                        <div class="garde-images-grille">
                            @foreach (var im in ImagesAffichees())
                            {
                                var image = im;
                                <div class="garde-image-miniature" title="@image.Nom" @onclick="() => AjouterImage(image)">
                                    @if (imagesChargees.ContainsKey(image.Source))
                                    {
                                        <img src="@imagesChargees[image.Source]" />
                                    }
                                    @if (image.Perso)
                                    {
                                        <button class="garde-miniature-supprimer" title="Supprimer cette image" @onclick="() => SupprimerImagePerso(image)" @onclick:stopPropagation="true">🗑</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <label class="garde-label">Importer ta propre image</label>
                    <InputFile class="garde-input" accept="image/png,image/jpeg" OnChange="ImporterImage" disabled="@importEnCours" />
                    @if (importEnCours)
                    {
                        <div class="garde-label">Envoi de l'image…</div>
                    }

                    @if (imageChoisie != null)
                    {
                        <div class="garde-section-title">Image choisie</div>

                        <label class="garde-label">Taille : @((int)imageChoisie.Largeur) px</label>
                        <input type="range" min="30" max="600" value="@((int)imageChoisie.Largeur)" @oninput="ChangerTailleImage" />

                        <label class="garde-label">Rotation : @((int)imageChoisie.Rotation)°</label>
                        <input type="range" min="-180" max="180" value="@((int)imageChoisie.Rotation)" @oninput="ChangerRotationImage" />
                        <div class="garde-ajout-textes">
                            <button class="garde-petit-btn" @onclick="() => TournerImage(-90)">↺ 90°</button>
                            <button class="garde-petit-btn" @onclick="() => TournerImage(90)">↻ 90°</button>
                            <button class="garde-petit-btn" @onclick="() => imageChoisie.Rotation = 0">0°</button>
                        </div>

                        <label class="garde-label">Placement : glisse l'image, tire le rond bleu pour l'agrandir, le ↻ pour la tourner</label>
                        <div class="garde-ajout-textes">
                            <button class="garde-petit-btn" @onclick="CentrerImage">↔ Centrer</button>
                            <button class="garde-petit-btn garde-btn-supprimer" @onclick="RetirerImage">🗑 Retirer de la page</button>
                        </div>
                    }
                </div>
            }

            <button class="garde-menu-item @(menuOuvert == "cadre" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("cadre")'>
                🖼️ Cadre
                <span class="garde-fleche">@(menuOuvert == "cadre" ? "▾" : "▸")</span>
            </button>

            @if (menuOuvert == "cadre")
            {
                <div class="garde-options">
                    <label class="garde-check">
                        <input type="checkbox" @bind="d.AvecCadre" />
                        Ajouter un cadre
                    </label>

                    @if (d.AvecCadre)
                    {
                        <label class="garde-label">Type de ligne</label>
                        <select class="garde-input" @bind="d.TypeLigne">
                            <option value="solid">Trait plein</option>
                            <option value="dashed">Tirets</option>
                            <option value="dotted">Pointillés</option>
                            <option value="double">Double trait</option>
                            <option value="emoji">Emoji / symbole</option>
                        </select>

                        @if (d.TypeLigne == "emoji")
                        {
                            <label class="garde-label">Symbole</label>
                            @if (chargementEmojis)
                            {
                                <div class="garde-label">Chargement des emojis…</div>
                            }
                            else if (emojis.Count == 0)
                            {
                                <div class="garde-label">Impossible de charger les emojis.</div>
                            }
                            else
                            {
                                <select class="garde-input" @bind="groupe">
                                    @foreach (var g in groupes)
                                    {
                                        <option value="@g.Key">@g.Value</option>
                                    }
                                </select>
                                <input class="garde-input" @bind="recherche" @bind:event="oninput" placeholder="Rechercher (ex : coeur, fleur)" />
                                <div class="garde-emojis">
                                    @foreach (var e in EmojisAffiches())
                                    {
                                        var em = e.Emoji;
                                        <button class="garde-emoji-btn @(d.Symbole == em ? "garde-emoji-actif" : "")" title="@e.Nom" @onclick="() => d.Symbole = em">@em</button>
                                    }
                                </div>
                            }
                            <input class="garde-input" @bind="d.Symbole" @bind:event="oninput" maxlength="4" placeholder="Ou tape ton symbole" />
                        }
                        else
                        {
                            <label class="garde-label">Couleur</label>
                            <input type="color" class="garde-color" @bind="d.Couleur" @bind:event="oninput" />
                        }

                        <label class="garde-label">Épaisseur : @d.Epaisseur px</label>
                        <input type="range" min="1" max="40" @bind="d.Epaisseur" @bind:event="oninput" />

                        <label class="garde-label">Marge depuis le bord : @d.Marge px</label>
                        <input type="range" min="0" max="100" @bind="d.Marge" @bind:event="oninput" />
                    }
                </div>
            }

            <div class="garde-enregistrer">
                <label class="garde-label">Nom de la page de garde</label>
                <input class="garde-input" @bind="nom" @bind:event="oninput" maxlength="150" placeholder="Ex : Cahier de maths" />

                @if (estAdmin)
                {
                    <label class="garde-check">
                        <input type="checkbox" @bind="pourTous" />
                        Pour tout le monde
                    </label>
                }

                @if (Id != null && !modifiable)
                {
                    <div class="garde-info">Ce modèle est partagé : l'enregistrer créera ta propre copie.</div>
                }

                @if (erreur != null)
                {
                    <div class="garde-erreur">@erreur</div>
                }
                @if (message != null)
                {
                    <div class="garde-succes">@message</div>
                }

                <button class="garde-btn-principal" @onclick="Enregistrer" disabled="@enCours">💾 Enregistrer</button>
                <button class="garde-petit-btn" @onclick="TelechargerPdf" disabled="@enCours">📥 Télécharger en PDF</button>
            </div>
        }
    </div>

    <div class="garde-apercu-zone">
        <div class="garde-apercu-scroll" @onwheel="ZoomMolette" @onwheel:preventDefault="true" @onmousemove="DeplacerElement" @onmouseup="FinDeplacement" @onmouseleave="FinDeplacement">
            <PageGardeFeuille Donnees="d" Zoom="zoom" IdElement="garde-feuille-edition" Modifiable="true"
                              ZoneChoisie="zoneChoisie" ImageChoisie="imageChoisie" Images="imagesChargees"
                              ReperesVisibles="ReperesVisibles()" AligneX="AligneX()" AligneY="AligneY()"
                              OnDebutDeplacement="DebutDeplacementElement" />
        </div>

        <div class="garde-zoom-barre">
            <button class="garde-zoom-btn" @onclick="ZoomMoins">−</button>
            <input type="range" class="garde-zoom-slider" min="@zoomMin" max="@zoomMax" step="10" @bind="zoom" @bind:event="oninput" />
            <button class="garde-zoom-pourcent" title="Revenir à 100 %" @onclick="() => zoom = 100">@zoom %</button>
            <button class="garde-zoom-btn" @onclick="ZoomPlus">+</button>
        </div>
    </div>

</div>

@code {
    [Parameter] public int? Id { get; set; }

    private PageGardeDonnees d = new PageGardeDonnees();
    private bool chargement = false;
    private string menuOuvert = "textes";

    private string nom = "";
    private bool pourTous = false;
    private bool estAdmin = false;
    private bool modifiable = true;
    private int idEnregistre = 0;
    private bool enCours = false;
    private string? erreur = null;
    private string? message = null;

    private int zoom = 100;
    private int zoomMin = 30;
    private int zoomMax = 300;

    private ZoneTexte? zoneChoisie = null;
    private ZoneTexte? zoneDeplacee = null;
    private ZoneImage? imageChoisie = null;
    private ZoneImage? imageDeplacee = null;
    private string modeDeplacement = "deplacer";
    private double departSourisX;
    private double departSourisY;
    private double departX;
    private double departY;
    private double departLargeur;
    private double centreRotationX;
    private double centreRotationY;

    private List<ImageGarde> imagesBiblio = new List<ImageGarde>();
    private Dictionary<string, string> imagesChargees = new Dictionary<string, string>();
    private bool chargementImages = true;
    private string categorieImage = "Toutes";
    private string rechercheImage = "";
    private bool importEnCours = false;

    private List<string> polices = new List<string>
    {
        "Arial", "Verdana", "Georgia", "Times New Roman", "Courier New", "Comic Sans MS", "Trebuchet MS", "Impact",
        "Roboto", "Merriweather", "Pacifico", "Lobster", "Dancing Script", "Indie Flower", "Permanent Marker", "Amatic SC"
    };

    private List<EmojiItem> emojis = new List<EmojiItem>();
    private bool chargementEmojis = true;
    private int groupe = 0;
    private string recherche = "";

    private Dictionary<int, string> groupes = new Dictionary<int, string>
    {
        { 0, "Smileys et émotions" },
        { 1, "Personnes" },
        { 3, "Animaux et nature" },
        { 4, "Nourriture" },
        { 5, "Voyages et lieux" },
        { 6, "Activités" },
        { 7, "Objets" },
        { 8, "Symboles" },
        { 9, "Drapeaux" }
    };

    protected override async Task OnInitializedAsync()
    {
        var role = await Auth.GetRoleAsync();
        estAdmin = role == "ADMIN";

        emojis = await Api.GetEmojisAsync();
        chargementEmojis = false;

        var resultatImages = await Api.GetImagesGardeAsync();
        imagesBiblio = resultatImages.Images;
        chargementImages = false;
        await ChargerMiniatures();
    }

    protected override async Task OnParametersSetAsync()
    {
        erreur = null;
        message = null;
        zoneChoisie = null;
        imageChoisie = null;

        if (Id == null)
        {
            d = new PageGardeDonnees();
            nom = "";
            pourTous = false;
            modifiable = true;
            idEnregistre = 0;
            return;
        }

        if (Id == idEnregistre)
            return;

        chargement = true;
        var resultat = await Api.GetPageGardeAsync(Id.Value);
        chargement = false;

        if (resultat.Page == null)
        {
            erreur = resultat.Err ?? "Page de garde introuvable.";
            d = new PageGardeDonnees();
            return;
        }

        var page = resultat.Page;
        d = LireDonnees(page.Contenu);
        nom = page.Nom;
        pourTous = page.PourTous;
        modifiable = page.Modifiable;
        if (modifiable)
            idEnregistre = page.Id;
        else
            idEnregistre = 0;

        foreach (var image in d.Images)
            await ChargerImage(image.Source);
    }

    private async Task<string?> ChargerImage(string source)
    {
        if (imagesChargees.ContainsKey(source))
            return imagesChargees[source];

        var dataUrl = await Api.GetImageGardeDataUrlAsync(source);
        if (dataUrl != null)
            imagesChargees[source] = dataUrl;
        return dataUrl;
    }

    private List<string> CategoriesImages()
    {
        var liste = new List<string>();
        foreach (var image in imagesBiblio)
        {
            if (!liste.Contains(image.Categorie))
                liste.Add(image.Categorie);
        }
        return liste;
    }

    private List<ImageGarde> ImagesAffichees()
    {
        var resultat = new List<ImageGarde>();
        foreach (var image in imagesBiblio)
        {
            if (rechercheImage != "")
            {
                if (image.Nom.ToLower().Contains(rechercheImage.ToLower()))
                    resultat.Add(image);
            }
            else if (categorieImage == "Toutes" || image.Categorie == categorieImage)
            {
                resultat.Add(image);
            }
        }
        return resultat;
    }

    private async Task ChargerMiniatures()
    {
        foreach (var image in ImagesAffichees())
        {
            if (!imagesChargees.ContainsKey(image.Source))
            {
                await ChargerImage(image.Source);
                StateHasChanged();
            }
        }
    }

    private async Task AjouterImage(ImageGarde image)
    {
        var dataUrl = await ChargerImage(image.Source);
        if (dataUrl == null)
        {
            erreur = "Impossible de charger l'image.";
            return;
        }

        var taille = await JS.InvokeAsync<TailleImage>("tailleImage", dataUrl);

        var zone = new ZoneImage();
        zone.Source = image.Source;
        zone.Largeur = 150;
        zone.Ratio = 1;
        if (taille.Largeur > 0)
            zone.Ratio = (double)taille.Hauteur / taille.Largeur;
        zone.X = d.Largeur() / 2;
        zone.Y = d.Hauteur() / 2;
        d.Images.Add(zone);
        ChoisirImage(zone);
    }

    private async Task ImporterImage(InputFileChangeEventArgs e)
    {
        erreur = null;
        var fichier = e.File;
        if (fichier.ContentType != "image/png" && fichier.ContentType != "image/jpeg")
        {
            erreur = "Choisis une image PNG ou JPEG.";
            return;
        }

        importEnCours = true;
        try
        {
            var flux = fichier.OpenReadStream(15 * 1024 * 1024);
            var memoire = new MemoryStream();
            await flux.CopyToAsync(memoire);
            byte[] octets = memoire.ToArray();

            var reduite = await JS.InvokeAsync<TailleImage>("redimensionnerImage", octets, fichier.ContentType, 1200);
            int virgule = reduite.DataUrl.IndexOf(',');
            string base64 = reduite.DataUrl.Substring(virgule + 1);
            string typeMime = reduite.DataUrl.StartsWith("data:image/png") ? "image/png" : "image/jpeg";

            string nomImage = Path.GetFileNameWithoutExtension(fichier.Name);
            var resultat = await Api.UploadImagePersoAsync(nomImage, typeMime, base64);
            if (resultat.Image == null)
            {
                erreur = resultat.Err ?? "L'envoi de l'image a échoué.";
            }
            else
            {
                imagesBiblio.Add(resultat.Image);
                imagesChargees[resultat.Image.Source] = reduite.DataUrl;
                categorieImage = "Mes images";
                rechercheImage = "";
                await AjouterImage(resultat.Image);
            }
        }
        catch (Exception ex)
        {
            erreur = "Impossible d'importer l'image : " + ex.Message;
        }
        importEnCours = false;
    }

    private async Task SupprimerImagePerso(ImageGarde image)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", "Supprimer l'image « " + image.Nom + " » ? Elle disparaîtra aussi des pages qui l'utilisent.");
        if (!ok)
            return;

        var resultat = await Api.DeleteImagePersoAsync(image.Source);
        if (!resultat.Ok)
        {
            erreur = resultat.Err ?? "La suppression a échoué.";
            return;
        }

        imagesBiblio.Remove(image);
        imagesChargees.Remove(image.Source);
        d.Images.RemoveAll(z => z.Source == image.Source);
        imageChoisie = null;
    }

    private void ChoisirTexte(ZoneTexte zone)
    {
        zoneChoisie = zone;
        imageChoisie = null;
    }

    private void ChoisirImage(ZoneImage image)
    {
        imageChoisie = image;
        zoneChoisie = null;
    }

    private void ChangerTailleImage(ChangeEventArgs e)
    {
        if (imageChoisie == null)
            return;
        int valeur;
        if (int.TryParse(e.Value?.ToString(), out valeur))
            imageChoisie.Largeur = valeur;
    }

    private void ChangerRotationImage(ChangeEventArgs e)
    {
        if (imageChoisie == null)
            return;
        int valeur;
        if (int.TryParse(e.Value?.ToString(), out valeur))
            imageChoisie.Rotation = valeur;
    }

    private void TournerImage(int degres)
    {
        if (imageChoisie == null)
            return;
        imageChoisie.Rotation = NormaliserAngle(imageChoisie.Rotation + degres);
    }

    private double NormaliserAngle(double angle)
    {
        while (angle > 180)
            angle = angle - 360;
        while (angle < -180)
            angle = angle + 360;
        return angle;
    }

    private void CentrerImage()
    {
        if (imageChoisie == null)
            return;
        imageChoisie.X = d.Largeur() / 2;
    }

    private void RetirerImage()
    {
        if (imageChoisie == null)
            return;
        d.Images.Remove(imageChoisie);
        imageChoisie = null;
    }

    private PageGardeDonnees LireDonnees(string contenu)
    {
        try
        {
            var donnees = System.Text.Json.JsonSerializer.Deserialize<PageGardeDonnees>(contenu);
            if (donnees != null)
                return donnees;
        }
        catch
        {
        }
        return new PageGardeDonnees();
    }

    private async Task Enregistrer()
    {
        erreur = null;
        message = null;

        if (nom.Trim() == "")
        {
            erreur = "Donne un nom à ta page de garde.";
            return;
        }

        enCours = true;

        var page = new PageGarde();
        page.Id = idEnregistre;
        page.Nom = nom.Trim();
        page.Contenu = System.Text.Json.JsonSerializer.Serialize(d);
        page.PourTous = estAdmin && pourTous;

        var resultat = await Api.SavePageGardeAsync(page);
        enCours = false;

        if (!resultat.Ok || resultat.Page == null)
        {
            erreur = resultat.Err ?? "L'enregistrement a échoué.";
            return;
        }

        message = "Page de garde enregistrée.";
        modifiable = true;

        if (idEnregistre != resultat.Page.Id)
        {
            idEnregistre = resultat.Page.Id;
            Nav.NavigateTo("/page-de-garde/" + idEnregistre);
        }
    }

    private async Task TelechargerPdf()
    {
        erreur = null;
        enCours = true;
        zoneChoisie = null;
        imageChoisie = null;
        StateHasChanged();

        string nomFichier = nom.Trim();
        if (nomFichier == "")
            nomFichier = "page-de-garde";

        try
        {
            await JS.InvokeVoidAsync("exporterPageGardePdf", "garde-feuille-edition", nomFichier + ".pdf", d.Orientation == "paysage");
        }
        catch (Exception ex)
        {
            erreur = "Impossible de créer le PDF : " + ex.Message;
        }

        enCours = false;
    }

    private void OuvrirMenu(string nomMenu)
    {
        if (menuOuvert == nomMenu)
            menuOuvert = "";
        else
            menuOuvert = nomMenu;
    }

    private void AjouterTexte(string texte, int taille, int y)
    {
        var zone = new ZoneTexte();
        zone.Texte = texte;
        zone.Taille = taille;
        zone.X = d.Largeur() / 2;
        zone.Y = y;
        if (zone.Y > d.Hauteur() - 20)
            zone.Y = d.Hauteur() / 2;
        if (texte == "Titre")
            zone.Gras = true;
        d.Textes.Add(zone);
        ChoisirTexte(zone);
    }

    private void SupprimerTexte()
    {
        if (zoneChoisie == null)
            return;
        d.Textes.Remove(zoneChoisie);
        zoneChoisie = null;
    }

    private void CentrerTexte()
    {
        if (zoneChoisie == null)
            return;
        zoneChoisie.X = d.Largeur() / 2;
    }

    private void DebutDeplacementElement(DebutDeplacement debut)
    {
        departSourisX = debut.ClientX;
        departSourisY = debut.ClientY;
        modeDeplacement = debut.Mode;

        if (debut.Zone != null)
        {
            ChoisirTexte(debut.Zone);
            zoneDeplacee = debut.Zone;
            menuOuvert = "textes";
            departX = debut.Zone.X;
            departY = debut.Zone.Y;
        }

        if (debut.Image != null)
        {
            ChoisirImage(debut.Image);
            imageDeplacee = debut.Image;
            menuOuvert = "images";
            departX = debut.Image.X;
            departY = debut.Image.Y;
            departLargeur = debut.Image.Largeur;

            if (debut.Mode == "rotation")
            {
                double echelle = zoom / 100.0;
                double distance = debut.Image.Largeur * debut.Image.Ratio / 2 + 20;
                double radians = debut.Image.Rotation * Math.PI / 180;
                centreRotationX = debut.ClientX - Math.Sin(radians) * distance * echelle;
                centreRotationY = debut.ClientY + Math.Cos(radians) * distance * echelle;
            }
        }
    }

    private bool ReperesVisibles()
    {
        if (zoneDeplacee != null)
            return true;
        if (imageDeplacee != null && modeDeplacement == "deplacer")
            return true;
        return false;
    }

    private bool AligneX()
    {
        if (zoneDeplacee != null)
            return zoneDeplacee.X == d.Largeur() / 2;
        if (imageDeplacee != null)
            return imageDeplacee.X == d.Largeur() / 2;
        return false;
    }

    private bool AligneY()
    {
        if (zoneDeplacee != null)
            return zoneDeplacee.Y == d.Hauteur() / 2;
        if (imageDeplacee != null)
            return imageDeplacee.Y == d.Hauteur() / 2;
        return false;
    }

    private void DeplacerElement(MouseEventArgs e)
    {
        if (zoneDeplacee == null && imageDeplacee == null)
            return;

        double echelle = zoom / 100.0;

        if (imageDeplacee != null && modeDeplacement == "taille")
        {
            double radians = imageDeplacee.Rotation * Math.PI / 180;
            double dx = e.ClientX - departSourisX;
            double dy = e.ClientY - departSourisY;
            double avance = dx * Math.Cos(radians) + dy * Math.Sin(radians);
            double largeur = departLargeur + 2 * avance / echelle;
            if (largeur < 30)
                largeur = 30;
            if (largeur > d.Largeur() * 2)
                largeur = d.Largeur() * 2;
            imageDeplacee.Largeur = largeur;
            return;
        }

        if (imageDeplacee != null && modeDeplacement == "rotation")
        {
            double angle = Math.Atan2(e.ClientX - centreRotationX, -(e.ClientY - centreRotationY)) * 180 / Math.PI;
            double proche = Math.Round(angle / 45) * 45;
            if (Math.Abs(angle - proche) < 4)
                angle = proche;
            imageDeplacee.Rotation = NormaliserAngle(Math.Round(angle));
            return;
        }

        double x = departX + (e.ClientX - departSourisX) / echelle;
        double y = departY + (e.ClientY - departSourisY) / echelle;

        if (x < 0)
            x = 0;
        if (x > d.Largeur())
            x = d.Largeur();
        if (y < 0)
            y = 0;
        if (y > d.Hauteur())
            y = d.Hauteur();

        int centreX = d.Largeur() / 2;
        int centreY = d.Hauteur() / 2;
        if (Math.Abs(x - centreX) < 6)
            x = centreX;
        if (Math.Abs(y - centreY) < 6)
            y = centreY;

        if (zoneDeplacee != null)
        {
            zoneDeplacee.X = x;
            zoneDeplacee.Y = y;
        }
        if (imageDeplacee != null)
        {
            imageDeplacee.X = x;
            imageDeplacee.Y = y;
        }
    }

    private void FinDeplacement()
    {
        zoneDeplacee = null;
        imageDeplacee = null;
    }

    private void ZoomPlus()
    {
        zoom = zoom + 10;
        if (zoom > zoomMax)
            zoom = zoomMax;
    }

    private void ZoomMoins()
    {
        zoom = zoom - 10;
        if (zoom < zoomMin)
            zoom = zoomMin;
    }

    private void ZoomMolette(WheelEventArgs e)
    {
        if (e.DeltaY < 0)
            ZoomPlus();
        else if (e.DeltaY > 0)
            ZoomMoins();
    }

    private List<EmojiItem> EmojisAffiches()
    {
        var resultat = new List<EmojiItem>();
        foreach (var e in emojis)
        {
            if (recherche != "")
            {
                if (e.Nom.ToLower().Contains(recherche.ToLower()))
                    resultat.Add(e);
            }
            else if (e.Groupe == groupe)
            {
                resultat.Add(e);
            }
        }
        return resultat;
    }
}
