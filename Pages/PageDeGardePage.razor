@page "/page-de-garde"

@inject ApiService Api

<div class="garde-page">

    <div class="garde-menu">
        <h2 class="garde-title">Page de garde</h2>

        <button class="garde-menu-item @(menuOuvert == "feuille" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("feuille")'>
            📄 Feuille
            <span class="garde-fleche">@(menuOuvert == "feuille" ? "▾" : "▸")</span>
        </button>

        @if (menuOuvert == "feuille")
        {
            <div class="garde-options">
                <label class="garde-label">Orientation</label>
                <label class="garde-check">
                    <input type="radio" name="orientation" checked="@(orientation == "portrait")" @onchange='() => orientation = "portrait"' />
                    Portrait
                </label>
                <label class="garde-check">
                    <input type="radio" name="orientation" checked="@(orientation == "paysage")" @onchange='() => orientation = "paysage"' />
                    Paysage
                </label>
            </div>
        }

        <button class="garde-menu-item @(menuOuvert == "textes" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("textes")'>
            🔤 Textes
            <span class="garde-fleche">@(menuOuvert == "textes" ? "▾" : "▸")</span>
        </button>

        @if (menuOuvert == "textes")
        {
            <div class="garde-options">
                <label class="garde-label">Ajouter</label>
                <div class="garde-ajout-textes">
                    <button class="garde-petit-btn" @onclick='() => AjouterTexte("Titre", 40, 150)'>+ Titre</button>
                    <button class="garde-petit-btn" @onclick='() => AjouterTexte("Nom Prénom", 22, 420)'>+ Nom Prénom</button>
                    <button class="garde-petit-btn" @onclick='() => AjouterTexte("Année 2026-2027", 18, 470)'>+ Année</button>
                    <button class="garde-petit-btn" @onclick='() => AjouterTexte("Texte", 18, 300)'>+ Texte libre</button>
                </div>

                @if (textes.Count > 0)
                {
                    <label class="garde-label">Zones de texte</label>
                    @foreach (var t in textes)
                    {
                        var zone = t;
                        <button class="garde-zone-ligne @(zoneChoisie == zone ? "garde-zone-ligne-actif" : "")" @onclick="() => zoneChoisie = zone">
                            @(zone.Texte == "" ? "(vide)" : zone.Texte)
                        </button>
                    }
                }

                @if (zoneChoisie != null)
                {
                    <div class="garde-section-title">Zone choisie</div>

                    <label class="garde-label">Texte</label>
                    <textarea class="garde-input" rows="2" @bind="zoneChoisie.Texte" @bind:event="oninput"></textarea>

                    <label class="garde-label">Police</label>
                    <select class="garde-input" @bind="zoneChoisie.Police" style="font-family:@zoneChoisie.Police;">
                        @foreach (var p in polices)
                        {
                            <option value="@p" style="font-family:@p;">@p</option>
                        }
                    </select>

                    <label class="garde-label">Taille : @zoneChoisie.Taille px</label>
                    <input type="range" min="8" max="120" @bind="zoneChoisie.Taille" @bind:event="oninput" />

                    <label class="garde-label">Couleur</label>
                    <input type="color" class="garde-color" @bind="zoneChoisie.Couleur" @bind:event="oninput" />

                    <div class="garde-ajout-textes">
                        <label class="garde-check">
                            <input type="checkbox" @bind="zoneChoisie.Gras" />
                            Gras
                        </label>
                        <label class="garde-check">
                            <input type="checkbox" @bind="zoneChoisie.Italique" />
                            Italique
                        </label>
                    </div>

                    <label class="garde-label">Placement : glisse le texte sur la feuille</label>
                    <div class="garde-ajout-textes">
                        <button class="garde-petit-btn" @onclick="CentrerTexte">↔ Centrer</button>
                        <button class="garde-petit-btn garde-btn-supprimer" @onclick="SupprimerTexte">🗑 Supprimer</button>
                    </div>
                }
            </div>
        }

        <button class="garde-menu-item @(menuOuvert == "cadre" ? "garde-menu-item-actif" : "")" @onclick='() => OuvrirMenu("cadre")'>
            🖼️ Cadre
            <span class="garde-fleche">@(menuOuvert == "cadre" ? "▾" : "▸")</span>
        </button>

        @if (menuOuvert == "cadre")
        {
            <div class="garde-options">
                <label class="garde-check">
                    <input type="checkbox" @bind="avecCadre" />
                    Ajouter un cadre
                </label>

                @if (avecCadre)
                {
                    <label class="garde-label">Type de ligne</label>
                    <select class="garde-input" @bind="typeLigne">
                        <option value="solid">Trait plein</option>
                        <option value="dashed">Tirets</option>
                        <option value="dotted">Pointillés</option>
                        <option value="double">Double trait</option>
                        <option value="emoji">Emoji / symbole</option>
                    </select>

                    @if (typeLigne == "emoji")
                    {
                        <label class="garde-label">Symbole</label>
                        @if (chargementEmojis)
                        {
                            <div class="garde-label">Chargement des emojis…</div>
                        }
                        else if (emojis.Count == 0)
                        {
                            <div class="garde-label">Impossible de charger les emojis.</div>
                        }
                        else
                        {
                            <select class="garde-input" @bind="groupe">
                                @foreach (var g in groupes)
                                {
                                    <option value="@g.Key">@g.Value</option>
                                }
                            </select>
                            <input class="garde-input" @bind="recherche" @bind:event="oninput" placeholder="Rechercher (ex : coeur, fleur)" />
                            <div class="garde-emojis">
                                @foreach (var e in EmojisAffiches())
                                {
                                    var em = e.Emoji;
                                    <button class="garde-emoji-btn @(symbole == em ? "garde-emoji-actif" : "")" title="@e.Nom" @onclick="() => symbole = em">@em</button>
                                }
                            </div>
                        }
                        <input class="garde-input" @bind="symbole" @bind:event="oninput" maxlength="4" placeholder="Ou tape ton symbole" />
                    }
                    else
                    {
                        <label class="garde-label">Couleur</label>
                        <input type="color" class="garde-color" @bind="couleur" @bind:event="oninput" />
                    }

                    <label class="garde-label">Épaisseur : @epaisseur px</label>
                    <input type="range" min="1" max="40" @bind="epaisseur" @bind:event="oninput" />

                    <label class="garde-label">Marge depuis le bord : @marge px</label>
                    <input type="range" min="0" max="100" @bind="marge" @bind:event="oninput" />
                }
            </div>
        }
    </div>

    <div class="garde-apercu-zone">
        <div class="garde-apercu-scroll" @onwheel="ZoomMolette" @onwheel:preventDefault="true" @onmousemove="DeplacerTexte" @onmouseup="FinDeplacement" @onmouseleave="FinDeplacement">
            <div class="garde-zoom-boite" style="width:@(LargeurFeuille() * zoom / 100)px; height:@(HauteurFeuille() * zoom / 100)px;">
                <div class="garde-feuille" style="width:@(LargeurFeuille())px; height:@(HauteurFeuille())px; transform:scale(@Echelle());">
                    @if (avecCadre)
                    {
                        if (typeLigne == "emoji")
                        {
                            <div class="garde-emoji-ligne" style="@StyleLigne("top")">
                                @for (int i = 0; i < NbHorizontal(); i++)
                                {
                                    <span>@symbole</span>
                                }
                            </div>
                            <div class="garde-emoji-ligne" style="@StyleLigne("bottom")">
                                @for (int i = 0; i < NbHorizontal(); i++)
                                {
                                    <span>@symbole</span>
                                }
                            </div>
                            <div class="garde-emoji-colonne" style="@StyleColonne("left")">
                                @for (int i = 0; i < NbVertical(); i++)
                                {
                                    <span>@symbole</span>
                                }
                            </div>
                            <div class="garde-emoji-colonne" style="@StyleColonne("right")">
                                @for (int i = 0; i < NbVertical(); i++)
                                {
                                    <span>@symbole</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="garde-cadre" style="top:@(marge)px; left:@(marge)px; right:@(marge)px; bottom:@(marge)px; border:@(epaisseur)px @typeLigne @couleur;"></div>
                        }
                    }

                    @foreach (var t in textes)
                    {
                        var zone = t;
                        <div class="garde-texte @(zoneChoisie == zone ? "garde-texte-choisi" : "")" style="@StyleTexte(zone)" @onmousedown="(e) => DebutDeplacement(e, zone)">@zone.Texte</div>
                    }
                </div>
            </div>
        </div>

        <div class="garde-zoom-barre">
            <button class="garde-zoom-btn" @onclick="ZoomMoins">−</button>
            <input type="range" class="garde-zoom-slider" min="@zoomMin" max="@zoomMax" step="10" @bind="zoom" @bind:event="oninput" />
            <button class="garde-zoom-pourcent" title="Revenir à 100 %" @onclick="() => zoom = 100">@zoom %</button>
            <button class="garde-zoom-btn" @onclick="ZoomPlus">+</button>
        </div>
    </div>

</div>

@code {
    private string menuOuvert = "cadre";
    private string orientation = "portrait";

    private int zoom = 100;
    private int zoomMin = 30;
    private int zoomMax = 300;

    private List<ZoneTexte> textes = new List<ZoneTexte>();
    private ZoneTexte? zoneChoisie = null;
    private ZoneTexte? zoneDeplacee = null;
    private double departSourisX;
    private double departSourisY;
    private double departX;
    private double departY;

    private List<string> polices = new List<string>
    {
        "Arial", "Verdana", "Georgia", "Times New Roman", "Courier New", "Comic Sans MS", "Trebuchet MS", "Impact",
        "Roboto", "Merriweather", "Pacifico", "Lobster", "Dancing Script", "Indie Flower", "Permanent Marker", "Amatic SC"
    };

    public class ZoneTexte
    {
        public string Texte { get; set; } = "";
        public string Police { get; set; } = "Arial";
        public int Taille { get; set; } = 18;
        public string Couleur { get; set; } = "#222222";
        public bool Gras { get; set; } = false;
        public bool Italique { get; set; } = false;
        public double X { get; set; }
        public double Y { get; set; }
    }

    private bool avecCadre = false;
    private string typeLigne = "solid";
    private string couleur = "#333333";
    private int epaisseur = 4;
    private int marge = 20;
    private string symbole = "⭐";

    private List<EmojiItem> emojis = new List<EmojiItem>();
    private bool chargementEmojis = true;
    private int groupe = 0;
    private string recherche = "";

    private Dictionary<int, string> groupes = new Dictionary<int, string>
    {
        { 0, "Smileys et émotions" },
        { 1, "Personnes" },
        { 3, "Animaux et nature" },
        { 4, "Nourriture" },
        { 5, "Voyages et lieux" },
        { 6, "Activités" },
        { 7, "Objets" },
        { 8, "Symboles" },
        { 9, "Drapeaux" }
    };

    protected override async Task OnInitializedAsync()
    {
        emojis = await Api.GetEmojisAsync();
        chargementEmojis = false;
    }

    private List<EmojiItem> EmojisAffiches()
    {
        var resultat = new List<EmojiItem>();
        foreach (var e in emojis)
        {
            if (recherche != "")
            {
                if (e.Nom.ToLower().Contains(recherche.ToLower()))
                    resultat.Add(e);
            }
            else if (e.Groupe == groupe)
            {
                resultat.Add(e);
            }
        }
        return resultat;
    }

    private void OuvrirMenu(string nom)
    {
        if (menuOuvert == nom)
            menuOuvert = "";
        else
            menuOuvert = nom;
    }

    private void AjouterTexte(string texte, int taille, int y)
    {
        var zone = new ZoneTexte();
        zone.Texte = texte;
        zone.Taille = taille;
        zone.X = LargeurFeuille() / 2;
        zone.Y = y;
        if (zone.Y > HauteurFeuille() - 20)
            zone.Y = HauteurFeuille() / 2;
        if (texte == "Titre")
            zone.Gras = true;
        textes.Add(zone);
        zoneChoisie = zone;
    }

    private void SupprimerTexte()
    {
        if (zoneChoisie == null)
            return;
        textes.Remove(zoneChoisie);
        zoneChoisie = null;
    }

    private void CentrerTexte()
    {
        if (zoneChoisie == null)
            return;
        zoneChoisie.X = LargeurFeuille() / 2;
    }

    private string StyleTexte(ZoneTexte zone)
    {
        string style = "left:" + ((int)zone.X) + "px; top:" + ((int)zone.Y) + "px;";
        style = style + " font-family:'" + zone.Police + "';";
        style = style + " font-size:" + zone.Taille + "px;";
        style = style + " color:" + zone.Couleur + ";";
        if (zone.Gras)
            style = style + " font-weight:bold;";
        if (zone.Italique)
            style = style + " font-style:italic;";
        return style;
    }

    private void DebutDeplacement(MouseEventArgs e, ZoneTexte zone)
    {
        zoneChoisie = zone;
        zoneDeplacee = zone;
        menuOuvert = "textes";
        departSourisX = e.ClientX;
        departSourisY = e.ClientY;
        departX = zone.X;
        departY = zone.Y;
    }

    private void DeplacerTexte(MouseEventArgs e)
    {
        if (zoneDeplacee == null)
            return;

        double echelle = zoom / 100.0;
        double x = departX + (e.ClientX - departSourisX) / echelle;
        double y = departY + (e.ClientY - departSourisY) / echelle;

        if (x < 0)
            x = 0;
        if (x > LargeurFeuille())
            x = LargeurFeuille();
        if (y < 0)
            y = 0;
        if (y > HauteurFeuille())
            y = HauteurFeuille();

        zoneDeplacee.X = x;
        zoneDeplacee.Y = y;
    }

    private void FinDeplacement()
    {
        zoneDeplacee = null;
    }

    private void ZoomPlus()
    {
        zoom = zoom + 10;
        if (zoom > zoomMax)
            zoom = zoomMax;
    }

    private void ZoomMoins()
    {
        zoom = zoom - 10;
        if (zoom < zoomMin)
            zoom = zoomMin;
    }

    private void ZoomMolette(WheelEventArgs e)
    {
        if (e.DeltaY < 0)
            ZoomPlus();
        else if (e.DeltaY > 0)
            ZoomMoins();
    }

    private string Echelle()
    {
        double valeur = zoom / 100.0;
        return valeur.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private int LargeurFeuille()
    {
        if (orientation == "paysage")
            return 594;
        return 420;
    }

    private int HauteurFeuille()
    {
        if (orientation == "paysage")
            return 420;
        return 594;
    }

    private int Taille()
    {
        if (epaisseur < 8)
            return 8;
        return epaisseur;
    }

    private int NbHorizontal()
    {
        int longueur = LargeurFeuille() - marge * 2;
        int nb = longueur / Taille();
        if (nb < 1)
            nb = 1;
        return nb;
    }

    private int NbVertical()
    {
        int longueur = HauteurFeuille() - marge * 2 - Taille() * 2;
        int nb = longueur / Taille();
        if (nb < 1)
            nb = 1;
        return nb;
    }

    private string StyleLigne(string cote)
    {
        return cote + ":" + marge + "px; left:" + marge + "px; right:" + marge + "px; height:" + Taille() + "px; font-size:" + (Taille() - 2) + "px;";
    }

    private string StyleColonne(string cote)
    {
        int debut = marge + Taille();
        return cote + ":" + marge + "px; top:" + debut + "px; bottom:" + debut + "px; width:" + Taille() + "px; font-size:" + (Taille() - 2) + "px;";
    }
}
