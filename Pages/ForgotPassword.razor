@* ─────────────────────────────────────────────────────────────────────────────
   ForgotPassword.razor — Demande de réinitialisation du mot de passe.

   L'utilisateur qui ne se souvient plus de son mot de passe saisit ici
   l'adresse e-mail de son compte. Le serveur (POST api/auth/forgot-password)
   génère un jeton valable 1 heure et envoie un lien à cette adresse.

   Le serveur répond toujours par le même message, que l'adresse soit inscrite
   ou non, pour ne pas révéler quels comptes existent. La page affiche donc
   simplement le message renvoyé, sans distinguer les deux cas.

   Le lien reçu par e-mail pointe vers /reset-password?token=... (ResetPassword.razor).
   ───────────────────────────────────────────────────────────────────────────── *@

@* Route : accessible depuis le lien « Mot de passe oublié ? » de la page de connexion *@
@page "/forgot-password"

@* Injection d'ApiService pour appeler l'endpoint de demande de réinitialisation *@
@inject ApiService Api

@* Injection de NavigationManager pour revenir à la page de connexion *@
@inject NavigationManager Nav

@* ── Mise en page (réutilise les styles de la page de connexion) ───────────── *@
<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">Mot de passe oublié</h1>
        <p class="login-subtitle">Recevez un lien de réinitialisation par e-mail</p>

        @if (!isSent)
        {
            @* ── État : formulaire ───────────────────────────────────────────
               Saisie de l'adresse e-mail du compte. Le bouton est désactivé
               pendant l'appel réseau pour éviter les doubles envois.
            ── *@
            <p class="forgot-hint">
                Indiquez l'adresse e-mail de votre compte : nous vous enverrons
                un lien pour choisir un nouveau mot de passe.
            </p>

            <div class="form-group">
                <input type="email" @bind="email" @onkeydown="HandleKeyDown"
                       placeholder="Email" class="form-input" />
                <button class="btn-submit" @onclick="HandleSubmit" disabled="@isLoading">
                    @(isLoading ? "Envoi en cours..." : "Envoyer le lien")
                </button>
            </div>
        }
        else
        {
            @* ── État : demande envoyée ──────────────────────────────────────
               Message générique du serveur + rappel de vérifier les spams.
            ── *@
            <div class="forgot-sent">
                <span class="forgot-icon">📧</span>
                <p class="success-message">@resultMessage</p>
                <p class="forgot-hint">
                    Le lien est valable <strong>1 heure</strong>.
                    Pensez à vérifier votre dossier de courriers indésirables.
                </p>
            </div>
        }

        @* ── Affichage des erreurs (validation, limite de débit, réseau) ───── *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }

        @* Retour à la page de connexion, disponible dans les deux états *@
        <p class="login-link">
            <a href="/login">← Retour à la connexion</a>
        </p>
    </div>
</div>

@code {
    @* Adresse e-mail saisie par l'utilisateur *@
    private string email = "";

    @* Empêche un second envoi pendant que l'appel réseau est en cours *@
    private bool isLoading = false;

    @* Passe à true quand le serveur a accepté la demande : le formulaire est remplacé
       par le message de confirmation, ce qui évite les envois répétés *@
    private bool isSent = false;

    @* Message de succès renvoyé par le serveur (volontairement générique) *@
    private string resultMessage = "";

    @* Message d'erreur affiché sous le formulaire *@
    private string errorMessage = "";

    /// <summary>
    /// Permet de valider le formulaire avec la touche Entrée depuis le champ e-mail.
    /// </summary>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    /// <summary>
    /// Envoie la demande de réinitialisation au serveur.
    /// Valide sommairement l'adresse côté client, puis affiche le message renvoyé
    /// par l'API (identique que le compte existe ou non).
    /// </summary>
    private async Task HandleSubmit()
    {
        // Effacement de l'erreur précédente avant une nouvelle tentative
        errorMessage = "";

        // Validation minimale côté client pour un retour immédiat
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            errorMessage = "Veuillez saisir une adresse e-mail valide.";
            return;
        }

        isLoading = true;

        // Appel de l'endpoint : (true, message générique) si la demande est acceptée
        var (success, message) = await Api.ForgotPasswordAsync(email.Trim());

        if (success)
        {
            // Bascule vers l'état « demande envoyée »
            resultMessage = message;
            isSent = true;
        }
        else
        {
            // Erreur de validation, limite de débit atteinte ou serveur inaccessible
            errorMessage = message;
        }

        isLoading = false;
    }
}
