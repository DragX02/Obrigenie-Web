@page "/login"

@inject ApiService Api

@inject AuthService Auth

@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">Obrigenie</h1>
        <p class="login-subtitle">Professional Agenda</p>

        <div class="oauth-buttons">
            <a href="api/auth/google" class="btn-oauth btn-google">
                Sign in with Google
            </a>

            <a href="api/auth/microsoft" class="btn-oauth btn-microsoft">
                Sign in with Outlook
            </a>
        </div>

        <div class="separator">
            <span>or</span>
        </div>

        <div class="tab-buttons">
            <button class="@(isRegister ? "" : "active")" @onclick="() => SwitchTab(false)">Login</button>
            <button class="@(isRegister ? "active" : "")" @onclick="() => SwitchTab(true)">Register</button>
        </div>

        @if (!isRegister)
        {
            <div class="form-group">
                <input type="email"    @bind="loginEmail"    placeholder="Email"    class="form-input" />
                <input type="password" @bind="loginPassword" placeholder="Password" class="form-input" />
                <button class="btn-submit" @onclick="HandleLogin" disabled="@isLoading">
                    @(isLoading ? "Logging in..." : "Log in")
                </button>
            </div>

            <p class="login-link">
                <a href="/forgot-password">Mot de passe oublié ?</a>
            </p>
        }
        else
        {
            <div class="form-group">
                <input type="text"     @bind="registerNom"             placeholder="Last name"                                        class="form-input" />
                <input type="text"     @bind="registerPrenom"          placeholder="First name"                                       class="form-input" />
                <input type="email"    @bind="registerEmail"           placeholder="Email"                                            class="form-input" />
                <input type="password" @bind="registerPassword"        placeholder="Password (min 6 chars, 1 uppercase, 1 digit)"     class="form-input" />
                <input type="password" @bind="registerConfirmPassword" placeholder="Confirm password"                                 class="form-input" />
                <button class="btn-submit" @onclick="HandleRegister" disabled="@isLoading">
                    @(isLoading ? "Registering..." : "Register")
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <p class="success-message">@successMessage</p>
        }
    </div>
</div>

@code {
    private bool isRegister = false;

    private bool isLoading = false;

    private string errorMessage = "";

    private string successMessage = "";

    private string loginEmail = "";

    private string loginPassword = "";

    private string registerNom = "";

    private string registerPrenom = "";

    private string registerEmail = "";

    private string registerPassword = "";

    private string registerConfirmPassword = "";

    private void SwitchTab(bool register)
    {
        isRegister     = register;
        errorMessage   = "";
        successMessage = "";
    }

    private async Task HandleLogin()
    {
        errorMessage   = "";
        successMessage = "";
        isLoading      = true;

        var (auth, error) = await Api.LoginAsync(new LoginDto { Email = loginEmail, Password = loginPassword });

        if (auth != null)
        {
            await Auth.SaveTokenAsync(auth.Token);

            await Auth.SaveEmailAsync(auth.Email);

            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            errorMessage = error ?? "Incorrect email or password.";
        }

        isLoading = false;
    }

    private async Task HandleRegister()
    {
        errorMessage   = "";
        successMessage = "";

        if (registerPassword != registerConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (registerPassword.Length < 6 ||
            !registerPassword.Any(char.IsUpper) ||
            !registerPassword.Any(char.IsDigit))
        {
            errorMessage = "Password must be at least 6 characters, contain 1 uppercase letter and 1 digit.";
            return;
        }

        isLoading = true;

        var (success, message) = await Api.RegisterAsync(new RegisterDto
        {
            Email           = registerEmail,
            Password        = registerPassword,
            ConfirmPassword = registerConfirmPassword,
            Nom             = registerNom,
            Prenom          = registerPrenom
        });

        if (success)
        {
            successMessage = message;
            isRegister     = false;

            loginEmail = registerEmail;

            registerNom = registerPrenom = registerEmail = "";
            registerPassword = registerConfirmPassword = "";
        }
        else
        {
            errorMessage = message;
        }

        isLoading = false;
    }
}
