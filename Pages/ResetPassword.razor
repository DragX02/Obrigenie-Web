@* ─────────────────────────────────────────────────────────────────────────────
   ResetPassword.razor — Choix d'un nouveau mot de passe.

   Cible du lien envoyé par e-mail après une demande depuis /forgot-password :
   /reset-password?token=...

   Au chargement, le jeton est vérifié auprès du serveur
   (GET api/auth/validate-reset-token) afin d'afficher immédiatement « lien
   expiré » plutôt que de laisser l'utilisateur saisir un mot de passe pour rien.

   Le formulaire poste ensuite le jeton et le nouveau mot de passe
   (POST api/auth/reset-password). Le jeton est à usage unique : il est effacé
   côté serveur dès que le mot de passe est enregistré.

   La page rend quatre états : vérification, formulaire, succès, lien invalide.
   ───────────────────────────────────────────────────────────────────────────── *@

@* Route : le lien du mail pointe vers /reset-password?token=... *@
@page "/reset-password"

@* Injection d'ApiService pour valider le jeton puis enregistrer le nouveau mot de passe *@
@inject ApiService Api

@* Injection de NavigationManager pour rediriger vers /login après le changement *@
@inject NavigationManager Nav

@* ── Mise en page (réutilise les styles de la page de connexion) ───────────── *@
<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">Nouveau mot de passe</h1>

        @* ── État : vérification du jeton ─────────────────────────────────── *@
        @if (isChecking)
        {
            <p class="login-subtitle">Vérification du lien...</p>
        }
        @* ── État : lien invalide ou expiré ───────────────────────────────── *@
        else if (!isTokenValid)
        {
            <div class="forgot-sent">
                <span class="forgot-icon">❌</span>
                <p class="error-message">@errorMessage</p>
                <p class="forgot-hint">
                    Un lien de réinitialisation n'est valable qu'une heure et ne fonctionne
                    qu'une seule fois. Vous pouvez en demander un nouveau.
                </p>
            </div>

            <div class="form-group">
                <button class="btn-submit" @onclick='() => Nav.NavigateTo("/forgot-password")'>
                    Demander un nouveau lien
                </button>
            </div>
        }
        @* ── État : mot de passe modifié ──────────────────────────────────── *@
        else if (isDone)
        {
            <div class="forgot-sent">
                <span class="forgot-icon">✅</span>
                <p class="success-message">@resultMessage</p>
            </div>

            <div class="form-group">
                <button class="btn-submit" @onclick='() => Nav.NavigateTo("/login")'>
                    Se connecter
                </button>
            </div>
        }
        @* ── État : formulaire de saisie ──────────────────────────────────── *@
        else
        {
            <p class="login-subtitle">Choisissez un nouveau mot de passe</p>

            <div class="form-group">
                <input type="password" @bind="password"
                       placeholder="Nouveau mot de passe (min 6 caractères, 1 majuscule, 1 chiffre)"
                       class="form-input" />
                <input type="password" @bind="confirmPassword" @onkeydown="HandleKeyDown"
                       placeholder="Confirmer le mot de passe" class="form-input" />
                <button class="btn-submit" @onclick="HandleSubmit" disabled="@isLoading">
                    @(isLoading ? "Enregistrement..." : "Enregistrer le mot de passe")
                </button>
            </div>

            @* Erreurs de validation ou refus du serveur *@
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }

            <p class="login-link">
                <a href="/login">← Retour à la connexion</a>
            </p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Le jeton de réinitialisation extrait du paramètre de requête "?token=...".
    /// Renseigné automatiquement par Blazor avant OnInitializedAsync.
    /// Null ou vide quand la page est ouverte sans passer par le lien e-mail.
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    @* True pendant la vérification initiale du jeton auprès du serveur *@
    private bool isChecking = true;

    @* True quand le serveur a confirmé que le jeton est exploitable *@
    private bool isTokenValid = false;

    @* True quand le nouveau mot de passe a été enregistré avec succès *@
    private bool isDone = false;

    @* Empêche une seconde soumission pendant l'appel réseau *@
    private bool isLoading = false;

    @* Nouveau mot de passe saisi *@
    private string password = "";

    @* Confirmation du nouveau mot de passe ; doit correspondre à password *@
    private string confirmPassword = "";

    @* Message de succès renvoyé par le serveur *@
    private string resultMessage = "";

    @* Message d'erreur affiché à l'utilisateur *@
    private string errorMessage = "";

    /// <summary>
    /// Appelé une fois au premier rendu.
    /// Vérifie la présence du jeton dans l'URL puis sa validité côté serveur,
    /// afin de choisir entre le formulaire et l'état « lien invalide ».
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Page ouverte sans jeton : l'utilisateur n'est pas passé par le lien e-mail
        if (string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "Aucun jeton de réinitialisation fourni. Lien invalide.";
            isChecking = false;
            return;
        }

        // Vérification sans effet de bord : le jeton reste utilisable pour la soumission
        var (valid, error) = await Api.ValidateResetTokenAsync(Token);

        isTokenValid = valid;
        if (!valid)
        {
            errorMessage = error ?? "Ce lien de réinitialisation est invalide ou a expiré.";
        }

        isChecking = false;
    }

    /// <summary>
    /// Permet de valider le formulaire avec la touche Entrée depuis le champ de confirmation.
    /// </summary>
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    /// <summary>
    /// Valide les deux champs côté client (mêmes règles qu'à l'inscription : 6 caractères,
    /// une majuscule, un chiffre) puis envoie le jeton et le nouveau mot de passe au serveur.
    /// En cas de succès, bascule sur l'état final proposant de se connecter.
    /// </summary>
    private async Task HandleSubmit()
    {
        // Effacement de l'erreur précédente avant une nouvelle tentative
        errorMessage = "";

        // Les deux mots de passe doivent être identiques
        if (password != confirmPassword)
        {
            errorMessage = "Les mots de passe ne correspondent pas.";
            return;
        }

        // Mêmes exigences de robustesse que le formulaire d'inscription, pour un retour immédiat
        if (password.Length < 6 ||
            !password.Any(char.IsUpper) ||
            !password.Any(char.IsDigit))
        {
            errorMessage = "Le mot de passe doit contenir au moins 6 caractères, 1 majuscule et 1 chiffre.";
            return;
        }

        isLoading = true;

        // Envoi du jeton et du nouveau mot de passe ; le serveur revalide tout de son côté
        var (success, message) = await Api.ResetPasswordAsync(Token!, password, confirmPassword);

        if (success)
        {
            // Bascule vers l'état final : le jeton est désormais consommé
            resultMessage = message;
            isDone = true;
        }
        else
        {
            // Jeton devenu invalide, mot de passe refusé, limite de débit ou panne réseau
            errorMessage = message;
        }

        isLoading = false;
    }
}
