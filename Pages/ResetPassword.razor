@page "/reset-password"

@inject ApiService Api

@inject NavigationManager Nav

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">Nouveau mot de passe</h1>

        @if (isChecking)
        {
            <p class="login-subtitle">Vérification du lien...</p>
        }
        else if (!isTokenValid)
        {
            <div class="forgot-sent">
                <span class="forgot-icon">❌</span>
                <p class="error-message">@errorMessage</p>
                <p class="forgot-hint">
                    Un lien de réinitialisation n'est valable qu'une heure et ne fonctionne
                    qu'une seule fois. Vous pouvez en demander un nouveau.
                </p>
            </div>

            <div class="form-group">
                <button class="btn-submit" @onclick='() => Nav.NavigateTo("/forgot-password")'>
                    Demander un nouveau lien
                </button>
            </div>
        }
        else if (isDone)
        {
            <div class="forgot-sent">
                <span class="forgot-icon">✅</span>
                <p class="success-message">@resultMessage</p>
            </div>

            <div class="form-group">
                <button class="btn-submit" @onclick='() => Nav.NavigateTo("/login")'>
                    Se connecter
                </button>
            </div>
        }
        else
        {
            <p class="login-subtitle">Choisissez un nouveau mot de passe</p>

            <div class="form-group">
                <input type="password" @bind="password"
                       placeholder="Nouveau mot de passe (min 6 caractères, 1 majuscule, 1 chiffre)"
                       class="form-input" />
                <input type="password" @bind="confirmPassword" @onkeydown="HandleKeyDown"
                       placeholder="Confirmer le mot de passe" class="form-input" />
                <button class="btn-submit" @onclick="HandleSubmit" disabled="@isLoading">
                    @(isLoading ? "Enregistrement..." : "Enregistrer le mot de passe")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-message">@errorMessage</p>
            }

            <p class="login-link">
                <a href="/login">← Retour à la connexion</a>
            </p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool isChecking = true;

    private bool isTokenValid = false;

    private bool isDone = false;

    private bool isLoading = false;

    private string password = "";

    private string confirmPassword = "";

    private string resultMessage = "";

    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "Aucun jeton de réinitialisation fourni. Lien invalide.";
            isChecking = false;
            return;
        }

        var (valid, error) = await Api.ValidateResetTokenAsync(Token);

        isTokenValid = valid;
        if (!valid)
        {
            errorMessage = error ?? "Ce lien de réinitialisation est invalide ou a expiré.";
        }

        isChecking = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSubmit();
    }

    private async Task HandleSubmit()
    {
        errorMessage = "";

        if (password != confirmPassword)
        {
            errorMessage = "Les mots de passe ne correspondent pas.";
            return;
        }

        if (password.Length < 6 ||
            !password.Any(char.IsUpper) ||
            !password.Any(char.IsDigit))
        {
            errorMessage = "Le mot de passe doit contenir au moins 6 caractères, 1 majuscule et 1 chiffre.";
            return;
        }

        isLoading = true;

        var (success, message) = await Api.ResetPasswordAsync(Token!, password, confirmPassword);

        if (success)
        {
            resultMessage = message;
            isDone = true;
        }
        else
        {
            errorMessage = message;
        }

        isLoading = false;
    }
}
