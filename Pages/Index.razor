                <button type="button" class="dow-btn" @onclick="() => AjouterCibleCopie(copieSourceDate.AddDays(14))">+2 sem.</button>
                <button type="button" class="dow-btn" @onclick="() => AjouterCibleCopie(copieSourceDate.AddDays(21))">+3 sem.</button>
                <button type="button" class="dow-btn" @onclick="AjouterQuatreSemaines">Les 4 prochaines</button>
            </div>

            @if (!CopieParSemaine)
            {
                <div class="report-raccourcis">
                    <span class="report-raccourcis-label">Semaine suivante :</span>
                    @foreach (var (jour, libelle) in RepeatDayButtons)
                    {
                        var j = jour;
                        <button type="button" class="dow-btn" @onclick="() => AjouterCibleCopie(JourDeLaSemaineSuivante(j))">@libelle</button>
                    }
                </div>
