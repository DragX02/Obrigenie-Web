    private void AjouterCreneau()
    {
        var dernierFin = creneauxSup.Count > 0 ? creneauxSup[^1].Fin : noteEnd;
        var debut = dernierFin.Add(TimeSpan.FromMinutes(15));
        var fin = debut.Add(TimeSpan.FromMinutes(15));
        if (fin < debut) fin = new TimeOnly(23, 59);
        creneauxSup.Add(new Creneau { Debut = debut, Fin = fin });
    }

    private string? ErreurCreneaux()
    {
        var tous = new List<Creneau> { new Creneau { Debut = noteStart, Fin = noteEnd } };
        tous.AddRange(creneauxSup);

        foreach (var c in tous)
        {
            if (c.Fin <= c.Debut)
                return $"Le créneau {c.Debut:HH\\:mm} – {c.Fin:HH\\:mm} : l'heure de fin doit être après l'heure de début.";
        }

        for (int i = 0; i < tous.Count; i++)
        {
            for (int j = i + 1; j < tous.Count; j++)
            {
                if (tous[i].Debut < tous[j].Fin && tous[j].Debut < tous[i].Fin)
                    return $"Les créneaux {tous[i].Debut:HH\\:mm} – {tous[i].Fin:HH\\:mm} et {tous[j].Debut:HH\\:mm} – {tous[j].Fin:HH\\:mm} se chevauchent.";
            }
        }

        return null;
    }

    private void ToggleCopieHeurePanel()
    {
        showCopieHeurePanel = !showCopieHeurePanel;
        noteSaveError = null;
        if (showCopieHeurePanel)
        {
            if (noteStart.Hour < 12) DecalerCopieHeure(new TimeOnly(13, 0));
            else DecalerCopieHeure(new TimeOnly(8, 0));
        }
    }

    private void DecalerCopieHeure(TimeOnly debut)
    {
        var duree = noteEnd - noteStart;
        if (duree <= TimeSpan.Zero) duree = TimeSpan.FromHours(1);
        copieHeureDebut = debut;
        copieHeureFin = debut.Add(duree);
        if (copieHeureFin < copieHeureDebut) copieHeureFin = new TimeOnly(23, 59);
    }

    private Note? LeconQuiChevauche()
    {
        if (currentDay == null) return null;

        foreach (var n in currentDay.Notes)
        {
            var debut = new TimeOnly(n.Hour, n.Minute);
            var fin = n.EndHour > 0 ? new TimeOnly(n.EndHour, n.EndMinute) : new TimeOnly(Math.Min(n.Hour + 1, 23), n.Minute);
            if (copieHeureDebut < fin && debut < copieHeureFin) return n;
        }

        return null;
    }

    private async Task CopierSurLeMemeJour()
    {
        if (currentDay == null || noteSaving || copieHeureFin <= copieHeureDebut) return;
        if (LeconQuiChevauche() is Note chevauche)
        {
            noteSaveError = $"Ce créneau chevauche la leçon de {NoteLayout.PlageHoraire(chevauche)}.";
            return;
        }

        noteSaveError = null;
        var copie = ReportNote.Copier(editingNote ?? new Note(), currentDate);
        ApplyFormTo(copie);
        copie.Hour      = copieHeureDebut.Hour;
        copie.Minute    = copieHeureDebut.Minute;
        copie.EndHour   = copieHeureFin.Hour;
        copie.EndMinute = copieHeureFin.Minute;

        noteSaving = true;
        var (ok, err) = await Api.SaveNoteAsync(copie);
        noteSaving = false;

        if (!ok) { noteSaveError = err; return; }

        showNoteModal       = false;
        showCopieHeurePanel = false;
        showCascadePanel    = false;
        cascadeSelection    = null;
        reportInfo = $"Leçon copiée de {copieHeureDebut:HH\\:mm} à {copieHeureFin:HH\\:mm} le {currentDate:dd/MM/yyyy}.";
        await UpdateCalendarView();
    }

