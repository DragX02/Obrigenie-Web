    private void OnTimeSlotClicked(int hour, Note? noteCliquee = null)
    {
        editingNote = noteCliquee ?? currentDay?.Notes.FirstOrDefault(n =>
            hour >= n.Hour && (hour < n.EndHour || (hour == n.EndHour && n.EndMinute > 0) || (n.EndHour == 0 && hour == n.Hour)));

        var (texteSansMarqueur, cibleDejaReportee) = ReportNote.Lire(editingNote?.Content);
        noteContent       = texteSansMarqueur;
        editingNoteReport = cibleDejaReportee;

        showReportPanel = false;
        showCopieHeurePanel = false;
        creneauxSup.Clear();
        noteTitre = editingNote?.Titre ?? "";
        reportNoteCible = currentDate.Date.AddDays(7);
        reportErreur    = null;
        noteStart   = editingNote != null
            ? new TimeOnly(editingNote.Hour, editingNote.Minute)
            : new TimeOnly(hour, 0);
        noteEnd     = editingNote != null && editingNote.EndHour > 0
            ? new TimeOnly(editingNote.EndHour, editingNote.EndMinute)
            : new TimeOnly(Math.Min(hour + 1, 18), 0);

        repeatStart = currentDate.Date;
        repeatEnd   = currentDate.Date;
        repeatDays.Clear();

        noteSaveError = null;
        noteSaving    = false;

        showNoteModal = true;
    }

    private async Task SaveNote()
    {
        if (currentDay == null || noteEnd <= noteStart || noteSaving) return;

        noteSaveError = null;

        if (cascadeRef?.ReferentielAComplete == true)
        {
            noteSaving = true;
            var erreurRef = await cascadeRef.SynchroniserReferentielAsync();
            noteSaving = false;
            if (erreurRef != null) { noteSaveError = erreurRef; return; }
        }

        if (editingNote != null)
        {
            ApplyFormTo(editingNote);

            var (ok, err) = await Api.SaveNoteAsync(editingNote);
            if (!ok) { noteSaveError = err; return; }
        }
        else
        {
            var dates = RepeatDates();
            if (dates.Count == 0) { noteSaveError = "Aucune date ne correspond aux jours cochés."; return; }

            if (ErreurCreneaux() is string erreurCreneaux) { noteSaveError = erreurCreneaux; return; }

            noteSaving = true;
            int creees = 0;

            var creneaux = new List<Creneau> { new Creneau { Debut = noteStart, Fin = noteEnd } };
            creneaux.AddRange(creneauxSup);

            foreach (var jour in dates)
            foreach (var creneau in creneaux)
            {
                var note = new Note
                {
                    Date = new DateTime(jour.Year, jour.Month, jour.Day, 0, 0, 0, DateTimeKind.Utc)
                };
                ApplyFormTo(note);
                note.Hour      = creneau.Debut.Hour;
                note.Minute    = creneau.Debut.Minute;
                note.EndHour   = creneau.Fin.Hour;
                note.EndMinute = creneau.Fin.Minute;

                var (ok, err) = await Api.SaveNoteAsync(note);
                if (!ok)
                {
                    noteSaving    = false;
                    noteSaveError = creees == 0 ? err : $"{creees} note(s) créée(s), puis erreur : {err}";
                    await UpdateCalendarView();
                    return;
                }

                creees++;
            }

            noteSaving = false;
        }

        showNoteModal    = false;
        showCascadePanel = false;
        cascadeSelection = null;
        await UpdateCalendarView();
    }

    private void ApplyFormTo(Note note)
    {
        note.Hour      = noteStart.Hour;
        note.Minute    = noteStart.Minute;
        note.EndHour   = noteEnd.Hour;
        note.EndMinute = noteEnd.Minute;
        note.Content   = noteContent;
        note.Titre     = string.IsNullOrWhiteSpace(noteTitre) ? null : noteTitre.Trim();

        if (cascadeSelection?.ADesVisees == true)
        {
            if (cascadeSelection.IdVisee > 0) note.IdViseeFk = cascadeSelection.IdVisee;
            note.ViseeContexte = cascadeSelection.EnTexte();
        }
    }

