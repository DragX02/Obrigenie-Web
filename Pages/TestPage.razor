
@* ─────────────────────────────────────────────────────────────────────────────
   TestPage.razor — Page de test de sélection en cascade.

   Flux de sélection en cascade réordonné (7 étapes) :
     1. Année            → Niveau (chargé en premier, tous niveaux ayant des visées)
     2. Cours            → tous les cours enseignés à ce niveau (ex : Français)
     3. Champ            → table domaine, pour la combinaison cours + niveau
     4. Domaine          → table sous_domaine, optionnel
     5. Compétences, savoirs, S-F → le champ competence de la visée
                            (Savoirs / Savoir-faire / Attendus / Compétences ÉCOUTER…)
     6. Visées           → NomVisée, filtrées par la compétence choisie —
                           sélection multiple avec recherche (MultiSelectSearch)
     7. Visées à maîtriser → celles des visées retenues (fusionnées, dédoublonnées) —
                           sélection multiple avec recherche également

   NB : « Compétence/Attendu » et « Visée » proviennent tous deux de la même requête
   (api/ref/visees) ; leur ordre d'affichage (competence avant nom_visee) est purement
   côté client. L'IdVisée est résolu à partir du couple (competence, nom_visee).

   Une sous-sélection de langue optionnelle apparaît lorsque le cours "LM" est choisi.
   ───────────────────────────────────────────────────────────────────────────── *@

@page "/test"
@inject AuthService Auth
@inject NavigationManager Nav
@inject ApiService Api

<PageTitle>Cascade Test</PageTitle>

@if (loadError != null)
{
    <div class="alert alert-danger m-3">
        <strong>API error:</strong> @loadError
        <br/>
        <small>
            Token present: @(tokenDebug != null ? $"yes ({tokenDebug})" : "NO — not logged in?")
        </small>
    </div>
}
else
{
    <div class="container mt-4">
        <h2>🧪 Cascading Selection Test</h2>
        <hr />

        <div class="row">
            @* ── Colonne gauche : listes déroulantes en cascade ── *@
            <div class="col-md-6">

                @* Étape 1 : année (niveau) *@
                <div class="mb-3">
                    <label class="form-label fw-bold">1. Année :</label>
                    <SearchableSelect Value="@selectedNiveau"
                                      ValueChanged="OnNiveauChanged"
                                      Placeholder="-- Choisir une année --"
                                      Options="OptionsNiveaux" EmptyValue="" />
                </div>

                @* Étape 2 : cours (tous les cours du niveau, toutes catégories confondues) *@
                @if (!string.IsNullOrEmpty(selectedNiveau))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">2. Cours :</label>
                        <SearchableSelect Value="@selectedCours"
                                          ValueChanged="OnCoursChanged"
                                          Placeholder="-- Choisir un cours --"
                                          Options="OptionsCours" EmptyValue="" />
                    </div>
                }

                @* Sous-sélection langue (LM uniquement) *@
                @if (selectedCours == "LM")
                {
                    <div class="mb-3 p-3 bg-light border rounded">
                        <label class="form-label fw-bold text-primary">⭐ Choisir la langue :</label>
                        <select class="form-select border-primary" value="@selectedLangue" @onchange="OnLangueChanged">
                            <option value="">-- Quelle langue ? --</option>
                            <option value="English">English</option>
                            <option value="Dutch">Dutch</option>
                            <option value="German">German</option>
                        </select>
                    </div>
                }

                @* À partir du champ, tout se complète : taper un nom absent des listes
                   propose de l'ajouter, et le bouton ouvre en plus les tables entières. *@
                @if (!string.IsNullOrEmpty(selectedCours))
                {
                    <div class="cascade-completion mb-3">
                        <button type="button" class="cascade-elargir" @onclick="BasculerElargir">
                            @(elargir ? "▾ Revenir au référentiel du champ" : "▸ Il manque une entrée ? Chercher dans toute la base")
                        </button>
                        <div class="cascade-elargir-note">
                            À partir d'ici, tape un nom : s'il n'existe pas encore, « ＋ Ajouter » le crée.
                            @if (elargir)
                            {
                                <text>Les étapes 5 à 8 affichent en ce moment les tables entières ;
                                ce qui n'existe pas encore pour ce champ devra être rattaché.</text>
                            }
                        </div>
                    </div>
                }

                @* Étape 3 : champ (table domaine du référentiel) *@
                @if (!string.IsNullOrEmpty(selectedCours))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">3. Champ :</label>
                        <SearchableSelect Value="@selectedIdDomaine.ToString()"
                                          ValueChanged="OnDomaineChanged"
                                          OnCreate="AjouterDomaine"
                                          Placeholder="-- Choisir un champ --"
                                          Options="OptionsDomaines" EmptyValue="0" />
                    </div>
                }

                @* Étape 4 : domaine (table sous_domaine du référentiel), optionnel.
                   Affichée même quand la liste est vide, pour y ajouter le premier. *@
                @if (selectedIdDomaine > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">4. Domaine <span class="text-muted">(optionnel)</span></label>
                        <SearchableSelect Value="@selectedIdSousD.ToString()"
                                          ValueChanged="OnSousDChanged"
                                          OnCreate="AjouterSousDomaine"
                                          Placeholder="-- Aucun --"
                                          Options="OptionsSousDomaines" EmptyValue="0" />
                    </div>
                }

                @* Étape 5 : compétences, savoirs, savoir-faire (champ competence de la visée) *@
                @if (selectedIdDomaine > 0 && (listeVisees.Count > 0 || elargir))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">5. Compétences, savoirs, S-F :</label>
                        <SearchableSelect Value="@selectedIdCompetence.ToString()"
                                          ValueChanged="OnCompetenceChanged"
                                          OnCreate="AjouterCompetence"
                                          Placeholder="-- Choisir --"
                                          Options="OptionsCompetences" EmptyValue="0" />

                    </div>
                }

                @* Étape 6 : visées (nom_visee) filtrées par la compétence choisie —
                   sélection multiple avec recherche *@
                @if (selectedIdCompetence > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">6. Visées <span class="text-muted fw-normal">(plusieurs possibles)</span></label>
                        <MultiSelectSearch Options="OptionsNomVisees"
                                           Selected="@ValeursNomVisees"
                                           OnToggle="ToggleNomVisee"
                                           OnCreate="AjouterNomVisee"
                                           Placeholder="Rechercher une visée…" />
                    </div>
                }

                @* Étape 7 : compétence des visées à maîtriser. Comme à l'étape 5, ce choix ne
                   filtre rien : il intitule le bloc des visées à maîtriser dans la note. *@
                @if (selectedIdNomVisees.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">7. Compétences, savoirs, S-F <span class="text-muted fw-normal">(des visées à maîtriser)</span></label>
                        <SearchableSelect Value="@selectedIdCompetenceVm.ToString()"
                                          ValueChanged="OnCompetenceVmChanged"
                                          OnCreate="AjouterCompetenceVm"
                                          Placeholder="-- Choisir --"
                                          Options="OptionsCompetences" EmptyValue="0" />
                    </div>
                }

                @* Étape 8 : visées à maîtriser des visées retenues — sélection multiple avec recherche *@
                @if (selectedIdNomVisees.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">8. Visées à maîtriser <span class="text-muted fw-normal">(plusieurs possibles)</span></label>
                        <MultiSelectSearch Options="OptionsViseesMaitriser"
                                           Selected="@ValeursVms"
                                           OnToggle="ToggleVm"
                                           OnCreate="AjouterViseeMaitriser"
                                           Placeholder="Rechercher une visée à maîtriser…" />
                    </div>
                }

                @* Complément du référentiel : crée en base les visées et les liens que
                   la sélection suppose mais qui n'existent pas encore. *@
                @if (ReferentielAComplete)
                {
                    <div class="alert alert-warning py-2">
                        <div class="mb-2">
                            Cette sélection n'existe pas encore telle quelle dans le référentiel
                            du champ choisi.
                        </div>
                        <button class="btn btn-sm btn-warning" @onclick="SynchroniserReferentiel" disabled="@synchro">
                            @(synchro ? "Création…" : "Créer les liens manquants en base")
                        </button>
                    </div>
                }
                @if (messageSynchro != null)
                {
                    <div class="alert @(erreurSynchro ? "alert-danger" : "alert-success") py-2">@messageSynchro</div>
                }

            </div>

            @* ── Colonne droite : récapitulatif ── *@
            <div class="col-md-6">
                <div class="card bg-dark text-light mt-4">
                    <div class="card-body">
                        <h5 class="card-title">Récapitulatif de la sélection :</h5>
                        <ul>
                            <li><strong>Année :</strong>      @(string.IsNullOrEmpty(selectedNiveau) ? "..." : (listeNiveaux.FirstOrDefault(n => n.CodeNiveau == selectedNiveau)?.NomNiveau ?? selectedNiveau))</li>
                            <li><strong>Cours :</strong>      @(string.IsNullOrEmpty(selectedCours) ? "..." : (listeCours.FirstOrDefault(c => c.CodeCours == selectedCours)?.NomCours ?? selectedCours))</li>
                            @if (selectedCours == "LM")
                            {
                                <li class="text-warning"><strong>Langue :</strong> @(string.IsNullOrEmpty(selectedLangue) ? "..." : selectedLangue)</li>
                            }
                            <li><strong>Champ :</strong>      @(selectedIdDomaine == 0 ? "..." : (domainesFiltres.FirstOrDefault(d => d.IdDom == selectedIdDomaine)?.Nom ?? "..."))</li>
                            <li><strong>Domaine :</strong>    @(selectedIdSousD == 0 ? "—" : (listeSousDomaines.FirstOrDefault(s => s.IdSousDomaine == selectedIdSousD)?.NomComp ?? "..."))</li>
                            @* Les compétences choisies n'ont pas de ligne à elles :
                               elles intitulent les deux blocs qu'elles qualifient. *@
                            <li>
                                <strong>@(LibelleBloc(NomCompetenceDe(selectedIdCompetence), "Visées")) :</strong>
                                @if (NomsViseesCochees.Count == 0) { <text>...</text> }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var nom in NomsViseesCochees) { <li>@nom</li> }
                                    </ul>
                                }
                            </li>
                            <li>
                                <strong>@(LibelleBloc(NomCompetenceDe(selectedIdCompetenceVm), "Visées à maîtriser")) :</strong>
                                @if (NomsVmCochees.Count == 0) { <text>...</text> }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var nom in NomsVmCochees) { <li>@nom</li> }
                                    </ul>
                                }
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string? loadError;
    private string? tokenDebug;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.IsTokenExpiredAsync())
        {
            await Auth.RemoveTokenAsync();
            Nav.NavigateTo("/login");
            return;
        }

        var token = await Auth.GetTokenAsync();
        tokenDebug = string.IsNullOrEmpty(token) ? null : token[..Math.Min(20, token.Length)] + "…";

        try
        {
            // Première étape de la cascade : tous les niveaux (années) disponibles
            listeNiveaux = await Api.GetNiveauxTousAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    // ── Sélections courantes ───────────────────────────────────────────────
    private string selectedNiveau        = "";  // étape 1 : année
    private string selectedCours         = "";  // étape 2 : cours
    private string selectedLangue        = "";  // sous-sélection LM
    private int    selectedIdDomaine     = 0;   // étape 3 : domaine
    private int    selectedIdSousD       = 0;   // étape 4 : sous-domaine (0 = aucun)
    private int    selectedIdCompetence  = 0;   // étape 5 : compétence / attendu

    // Étape 7 : compétence des visées à maîtriser. Ne filtre rien, sert d'intitulé.
    private int    selectedIdCompetenceVm = 0;

    // Étapes 6 et 7 : sélection multiple par cases à cocher.
    // selectedIdVisees est dérivé de selectedIdNomVisees (couple compétence + nom_visee).
    private readonly HashSet<int> selectedIdNomVisees = new();   // étape 6 : visées cochées
    private readonly HashSet<int> selectedIdVisees    = new();   // IdVisée résolus
    private readonly HashSet<int> selectedIdVms       = new();   // étape 7 : VM cochées

    // ── Listes chargées depuis l'API ──────────────────────────────────────
    private List<NiveauDto>             listeNiveaux         = new();
    private List<CoursDto>              listeCours           = new();
    private List<DomaineDto>            domainesFiltres      = new();
    private List<SousDomaineRefDto>     listeSousDomaines    = new();
    private List<ViseeRefDto>           listeVisees          = new();   // toutes les visées du domaine (+ sous-domaine)
    private List<ViseesMaitriserRefDto> listeViseesMaitriser = new();

    // ── Listes dérivées ───────────────────────────────────────────────────

    // Étape 5 : compétences distinctes parmi les visées chargées
    private IEnumerable<(int Id, string Nom)> ListeCompetences =>
        listeVisees
            .GroupBy(v => v.IdCompetence)
            .Select(g => (Id: g.Key, Nom: g.First().NomCompetence))
            .OrderBy(x => x.Nom);

    // Étape 6 : nom_visee distincts pour la compétence choisie
    private IEnumerable<(int Id, string Nom)> ListeNomVisees =>
        listeVisees
            .Where(v => v.IdCompetence == selectedIdCompetence)
            .GroupBy(v => v.IdNomVisee)
            .Select(g => (Id: g.Key, Nom: g.First().NomVisee))
            .OrderBy(x => x.Nom);

    // ── Mode élargi : listes complètes des tables du référentiel ──────────
    private bool elargir;
    private bool synchro;
    private bool erreurSynchro;
    private string? messageSynchro;

    private List<CompetenceRefDto>       toutesCompetences = new();
    private List<NomViseeRefDto>         tousNomVisees     = new();
    private List<ViseesMaitriserRefDto>  toutesVm          = new();

    private async Task BasculerElargir()
    {
        elargir = !elargir;
        if (!elargir || toutesCompetences.Count > 0) return;

        try
        {
            toutesCompetences = await Api.GetCompetencesRefAsync();
            tousNomVisees     = await Api.GetNomViseesRefAsync();
            toutesVm          = await Api.GetToutesViseesMaitriserRefAsync();
        }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // Trois entrées toujours proposées à l'étape 5, en plus de celles du champ.
    // Celle qui n'existe pas encore dans la table est créée quand on la choisit.
    private static readonly string[] CompetencesToujoursProposees =
        { "Compétences", "Savoirs", "Savoir-faire" };

    private const string PrefixeNouveau = "nouveau:";

    // Options des quatre premières étapes (mêmes listes qu'avant, en composant cherchable)
    private IEnumerable<SearchableSelect.SelectOption> OptionsNiveaux =>
        listeNiveaux.Select(n => Opt(n.CodeNiveau, n.NomNiveau));

    private IEnumerable<SearchableSelect.SelectOption> OptionsCours =>
        listeCours.Select(c => Opt(c.CodeCours, c.NomCours));

    private IEnumerable<SearchableSelect.SelectOption> OptionsDomaines =>
        domainesFiltres.Select(d => Opt(d.IdDom.ToString(), d.Nom));

    private IEnumerable<SearchableSelect.SelectOption> OptionsSousDomaines =>
        listeSousDomaines.Select(s => Opt(s.IdSousDomaine.ToString(), s.NomComp));

    private IEnumerable<SearchableSelect.SelectOption> OptionsCompetences =>
        Fusionner(
            elargir
                ? Fusionner(ListeCompetences.Select(c => Opt(c.Id.ToString(), c.Nom)),
                            toutesCompetences.OrderBy(c => c.NomCompetence)
                                             .Select(c => Opt(c.IdCompetence.ToString(), c.NomCompetence)))
                : ListeCompetences.Select(c => Opt(c.Id.ToString(), c.Nom)),
            CompetencesToujoursProposees.Select(OptionCompetenceFigee));

    private SearchableSelect.SelectOption OptionCompetenceFigee(string nom)
    {
        var connue = toutesCompetences.FirstOrDefault(
            c => string.Equals(c.NomCompetence.Trim(), nom, StringComparison.OrdinalIgnoreCase));
        return connue != null ? Opt(connue.IdCompetence.ToString(), connue.NomCompetence)
                              : Opt($"{PrefixeNouveau}{nom}", nom);
    }

    // Libellé d'une compétence : depuis les visées du champ, sinon depuis la table complète
    private string? NomCompetenceDe(int idCompetence) =>
        idCompetence == 0 ? null
        : listeVisees.FirstOrDefault(v => v.IdCompetence == idCompetence)?.NomCompetence
          ?? toutesCompetences.FirstOrDefault(c => c.IdCompetence == idCompetence)?.NomCompetence;

    // Intitulé d'un bloc du récapitulatif : la compétence choisie, à défaut le générique
    private static string LibelleBloc(string? competence, string defaut) =>
        string.IsNullOrWhiteSpace(competence) ? defaut : competence;

    // ── Options et sélections passées à MultiSelectSearch ─────────────────
    private static SearchableSelect.SelectOption Opt(string value, string label) => new(value, label);

    // En mode élargi, les listes viennent des tables complètes ; les entrées déjà
    // rattachées au champ restent en tête pour rester repérables.
    private IEnumerable<SearchableSelect.SelectOption> OptionsNomVisees =>
        elargir
            ? Fusionner(ListeNomVisees.Select(nv => Opt(nv.Id.ToString(), nv.Nom)),
                        tousNomVisees.Select(nv => Opt(nv.IdNomVisee.ToString(), nv.NomVisee)))
            : ListeNomVisees.Select(nv => Opt(nv.Id.ToString(), nv.Nom));

    private IEnumerable<SearchableSelect.SelectOption> OptionsViseesMaitriser =>
        elargir
            ? Fusionner(listeViseesMaitriser.Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser)),
                        toutesVm.Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser)))
            : listeViseesMaitriser.Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser));

    // Concatène deux listes d'options en écartant les doublons de valeur.
    private static IEnumerable<SearchableSelect.SelectOption> Fusionner(
        IEnumerable<SearchableSelect.SelectOption> tete,
        IEnumerable<SearchableSelect.SelectOption> reste)
    {
        var vues = new HashSet<string>();
        foreach (var o in tete.Concat(reste))
            if (vues.Add(o.Value)) yield return o;
    }

    private IReadOnlyCollection<string> ValeursNomVisees =>
        selectedIdNomVisees.Select(i => i.ToString()).ToList();

    private IReadOnlyCollection<string> ValeursVms =>
        selectedIdVms.Select(i => i.ToString()).ToList();

    // Récapitulatif : libellés retenus, dans l'ordre d'affichage des listes
    private List<string> NomsViseesCochees => LibellesRetenus(OptionsNomVisees, selectedIdNomVisees);
    private List<string> NomsVmCochees     => LibellesRetenus(OptionsViseesMaitriser, selectedIdVms);

    private static List<string> LibellesRetenus(
        IEnumerable<SearchableSelect.SelectOption> options, HashSet<int> retenus) =>
        options.Where(o => int.TryParse(o.Value, out var id) && retenus.Contains(id))
               .Select(o => o.Label).ToList();

    // ── Gestionnaires ─────────────────────────────────────────────────────

    private async Task OnNiveauChanged(string? value)
    {
        selectedNiveau = value ?? "";
        ResetFrom(1);
        await ChargerCours();
    }

    private async Task OnCoursChanged(string? value)
    {
        selectedCours = value ?? "";
        ResetFrom(2);
        await ChargerDomaines();
    }

    private void OnLangueChanged(ChangeEventArgs e)
    {
        selectedLangue = e.Value?.ToString() ?? "";
    }

    private async Task OnDomaineChanged(string? value)
    {
        selectedIdDomaine = int.TryParse(value, out var v) ? v : 0;
        ResetFrom(3);
        if (selectedIdDomaine > 0)
        {
            try { listeSousDomaines = await Api.GetSousDomainesRefAsync(selectedIdDomaine); }
            catch (Exception ex) { loadError = ex.Message; }
            await ChargerVisees();
        }
    }

    private async Task OnSousDChanged(string? value)
    {
        selectedIdSousD = int.TryParse(value, out var v) ? v : 0;
        ResetFrom(4);
        await ChargerVisees();
    }

    // ── Ajout des entrées, à partir du champ ──────────────────────────────
    // Année, catégorie et cours sont des données fixes : ils ne s'ajoutent pas ici.

    private async Task AjouterDomaine(string nom)
    {
        if (string.IsNullOrEmpty(selectedCours) || string.IsNullOrEmpty(selectedNiveau)) return;

        var (ok, id, err) = await Api.CreateRefDomaineAsync(nom, selectedCours, selectedNiveau);
        if (!ok || id == 0) { loadError = err ?? "Ajout du champ refusé."; return; }

        await ChargerDomaines();
        await OnDomaineChanged(id.ToString());
    }

    private async Task AjouterSousDomaine(string nom)
    {
        if (selectedIdDomaine == 0) return;

        var (ok, id, err) = await Api.CreateRefSousDomaineAsync(nom, selectedIdDomaine);
        if (!ok || id == 0) { loadError = err ?? "Ajout du domaine refusé."; return; }

        try { listeSousDomaines = await Api.GetSousDomainesRefAsync(selectedIdDomaine); }
        catch (Exception ex) { loadError = ex.Message; }

        await OnSousDChanged(id.ToString());
    }

    // Étape 7 : compétence qui intitulera le bloc des visées à maîtriser
    private async Task OnCompetenceVmChanged(string? value)
    {
        if (value != null && value.StartsWith(PrefixeNouveau, StringComparison.Ordinal))
        {
            await AjouterCompetenceVm(value[PrefixeNouveau.Length..]);
            return;
        }

        selectedIdCompetenceVm = int.TryParse(value, out var v) ? v : 0;
    }

    private async Task AjouterCompetenceVm(string nom)
    {
        var (ok, id, err) = await Api.CreateRefCompetenceAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la compétence refusé."; return; }

        try { toutesCompetences = await Api.GetCompetencesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        selectedIdCompetenceVm = id;
    }

    // Étape 5 : sélection de la compétence / attendu
    private async Task OnCompetenceChanged(string? value)
    {
        // Entrée toujours proposée mais absente de la table : on la crée à la volée.
        if (value != null && value.StartsWith(PrefixeNouveau, StringComparison.Ordinal))
        {
            await AjouterCompetence(value[PrefixeNouveau.Length..]);
            return;
        }

        selectedIdCompetence = int.TryParse(value, out var v) ? v : 0;
        ViderVisees();
    }

    // ── Ajout d'entrées absentes du référentiel ───────────────────────────
    // Ce qui n'existe nulle part est créé puis immédiatement sélectionné. Les appels
    // sont rejouables côté serveur : un nom déjà présent rend son identifiant.

    private async Task AjouterCompetence(string nom)
    {
        var (ok, id, err) = await Api.CreateRefCompetenceAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la compétence refusé."; return; }

        try { toutesCompetences = await Api.GetCompetencesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        selectedIdCompetence = id;
        ViderVisees();
    }

    private async Task AjouterNomVisee(string nom)
    {
        var (ok, id, err) = await Api.CreateRefNomViseeAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la visée refusé."; return; }

        // La nouvelle entrée n'appartient à aucun champ : le mode élargi s'active de
        // lui-même pour qu'elle figure dans la liste.
        elargir = true;
        try { tousNomVisees = await Api.GetNomViseesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        await ToggleNomVisee(id.ToString());
    }

    private async Task AjouterViseeMaitriser(string nom)
    {
        var (ok, id, err) = await Api.CreateRefViseeMaitriserAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la visée à maîtriser refusé."; return; }

        elargir = true;
        try { toutesVm = await Api.GetToutesViseesMaitriserRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        ToggleVm(id.ToString());
    }

    // Étape 6 : ajoute / retire une visée. Les visées à maîtriser proposées sont
    // celles de l'ensemble des visées retenues.
    private async Task ToggleNomVisee(string valeur)
    {
        if (!int.TryParse(valeur, out var idNomVisee)) return;
        if (!selectedIdNomVisees.Remove(idNomVisee)) selectedIdNomVisees.Add(idNomVisee);

        // Résoudre les IdVisée correspondants (couple compétence + nom_visee)
        selectedIdVisees.Clear();
        foreach (var id in selectedIdNomVisees)
        {
            var visee = listeVisees.FirstOrDefault(x => x.IdCompetence == selectedIdCompetence
                                                     && x.IdNomVisee   == id);
            if (visee != null) selectedIdVisees.Add(visee.IdVisee);
        }

        await ChargerViseesMaitriser();
    }

    // Étape 7 : ajoute / retire une visée à maîtriser
    private void ToggleVm(string valeur)
    {
        if (!int.TryParse(valeur, out var idVm)) return;
        if (!selectedIdVms.Remove(idVm)) selectedIdVms.Add(idVm);
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    private void ResetFrom(int level)
    {
        if (level <= 1) { selectedCours = ""; listeCours.Clear(); selectedLangue = ""; }
        // Les aptitudes dépendent du cours : elles ne survivent pas à un changement d'année
        // ou de cours, mais restent cochées quand on navigue plus bas dans la cascade.
        if (level <= 2) { selectedIdDomaine = 0; domainesFiltres.Clear(); }
        if (level <= 3) { selectedIdSousD = 0; listeSousDomaines.Clear(); }
        // Étapes 5+ (compétence / visées / VM) toujours réinitialisées
        selectedIdCompetence = 0;
        listeVisees.Clear();
        ViderVisees();
    }

    // Vide les étapes 6 et 7 (visées cochées et visées à maîtriser proposées).
    private void ViderVisees()
    {
        selectedIdCompetenceVm = 0;
        selectedIdNomVisees.Clear();
        selectedIdVisees.Clear();
        selectedIdVms.Clear();
        listeViseesMaitriser.Clear();
    }

    // Charge tous les cours enseignés au niveau choisi. Le référentiel n'expose les
    // cours que catégorie par catégorie : on parcourt donc les catégories du niveau
    // et on fusionne leurs cours, dédoublonnés par code (un cours peut être rattaché
    // à plusieurs catégories).
    private async Task ChargerCours()
    {
        listeCours.Clear();
        if (string.IsNullOrEmpty(selectedNiveau)) return;
        try
        {
            var categories = await Api.GetCategoriesByNiveauAsync(selectedNiveau);
            var parCode = new Dictionary<string, CoursDto>();
            foreach (var cat in categories)
                foreach (var c in await Api.GetCoursByCatNiveauAsync(cat.IdCat, selectedNiveau))
                    parCode[c.CodeCours] = c;
            listeCours = parCode.Values.OrderBy(c => c.NomCours).ToList();
        }
        catch (Exception ex) { loadError = ex.Message; }
    }

    private async Task ChargerDomaines()
    {
        domainesFiltres.Clear();
        if (string.IsNullOrEmpty(selectedCours) || string.IsNullOrEmpty(selectedNiveau)) return;
        try { domainesFiltres = await Api.GetDomainesAsync(selectedCours, selectedNiveau); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    private async Task ChargerVisees()
    {
        listeVisees.Clear();
        selectedIdCompetence = 0;
        ViderVisees();
        if (selectedIdDomaine == 0) return;
        try { listeVisees = await Api.GetViseesRefAsync(selectedIdDomaine, selectedIdSousD > 0 ? selectedIdSousD : null); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // ── Complément du référentiel ─────────────────────────────────────────

    // Vrai quand la sélection suppose des liens qui n'existent pas encore en base.
    private bool ReferentielAComplete =>
        selectedIdCompetence > 0 &&
        (selectedIdNomVisees.Any(id => ViseeExistante(id) == 0) ||
         (selectedIdVisees.Count > 0 &&
          selectedIdVms.Any(idVm => !listeViseesMaitriser.Any(vm => vm.IdViseesMaitriser == idVm))));

    // Identifiant de la visée reliant le champ courant à ce nom_visee, 0 si absente.
    private int ViseeExistante(int idNomVisee) =>
        listeVisees.FirstOrDefault(v => v.IdCompetence == selectedIdCompetence
                                     && v.IdNomVisee   == idNomVisee)?.IdVisee ?? 0;

    // Crée les visées manquantes pour ce champ, puis les liens vers les visées à
    // maîtriser retenues, et relit les listes.
    private async Task SynchroniserReferentiel()
    {
        synchro = true; messageSynchro = null; erreurSynchro = false;

        foreach (var idNomVisee in selectedIdNomVisees.ToList())
        {
            if (ViseeExistante(idNomVisee) != 0) continue;

            var (ok, _, err) = await Api.CreateRefViseeAsync(
                selectedIdDomaine, selectedIdSousD, idNomVisee, selectedIdCompetence);
            if (!ok) { synchro = false; erreurSynchro = true; messageSynchro = err; return; }
        }

        // Relecture : les visées créées ont maintenant un identifiant
        try
        {
            listeVisees = await Api.GetViseesRefAsync(
                selectedIdDomaine, selectedIdSousD > 0 ? selectedIdSousD : null);
        }
        catch (Exception ex) { synchro = false; erreurSynchro = true; messageSynchro = ex.Message; return; }

        selectedIdVisees.Clear();
        foreach (var idNomVisee in selectedIdNomVisees)
        {
            var id = ViseeExistante(idNomVisee);
            if (id != 0) selectedIdVisees.Add(id);
        }

        var idVisee = selectedIdVisees.FirstOrDefault();
        if (idVisee != 0)
        {
            foreach (var idVm in selectedIdVms.ToList())
            {
                if (listeViseesMaitriser.Any(vm => vm.IdViseesMaitriser == idVm)) continue;

                var (ok, err) = await Api.CreateRefLienViseeMaitriseAsync(idVisee, idVm);
                if (!ok) { synchro = false; erreurSynchro = true; messageSynchro = err; return; }
            }
            await ChargerViseesMaitriser();
        }

        synchro = false;
        messageSynchro = "Référentiel complété : la sélection existe maintenant en base.";
    }

    // Visées à maîtriser de toutes les visées cochées, fusionnées et dédoublonnées.
    // Les cases cochées qui ne sont plus proposées sont abandonnées.
    private async Task ChargerViseesMaitriser()
    {
        var parId = new Dictionary<int, ViseesMaitriserRefDto>();
        foreach (var idVisee in selectedIdVisees)
        {
            try
            {
                foreach (var vm in await Api.GetViseesMaitriserRefAsync(idVisee))
                    parId[vm.IdViseesMaitriser] = vm;
            }
            catch (Exception ex) { loadError = ex.Message; }
        }
        listeViseesMaitriser = parId.Values.OrderBy(vm => vm.NomViseesMaitriser).ToList();
        // En mode élargi, une visée à maîtriser peut venir de la table complète sans être
        // encore reliée : on ne l'abandonne pas, le lien reste à créer.
        if (!elargir) selectedIdVms.RemoveWhere(id => !parId.ContainsKey(id));
    }
}
