@page "/conges"

@inject ApiService Api
@inject CalendarService CalendarSvc
@inject NavigationManager Nav

<div class="conges-page">
    <div class="conges-card">

        <h2 class="conges-title">Mes congés</h2>
        <p class="conges-intro">
            Les dates ci-dessous viennent du calendrier scolaire officiel, pour l'année scolaire
            en cours et la suivante. Corrige-les si elles ne correspondent pas à ton école :
            tes modifications ne s'appliquent qu'à ton calendrier.
        </p>

        @if (chargement)
        {
            <div class="conges-loading">Chargement…</div>
        }
        else
        {
            @if (erreur != null)
            {
                <p class="modal-error">@erreur</p>
            }

            <div class="conges-section-title">Calendrier officiel</div>

            @if (congesOfficiels.Count == 0)
            {
                <div class="conges-vide">Aucun congé officiel n'a pu être chargé.</div>
            }

            int anneeAffichee = 0;

            @foreach (var conge in congesOfficiels)
            {
                var id = conge.Id;
                var ligne = Ligne(id);

                var annee = CalendarService.AnneeScolaire(conge.StartDate);
                if (annee != anneeAffichee)
                {
                    anneeAffichee = annee;
                    <div class="conges-annee">Année scolaire @annee-@(annee + 1)</div>
                }

                <div class="conge-row @(ligne.Masque ? "conge-row-masquee" : "")">
                    <input class="conge-nom" @bind="ligne.Nom" />

                    <div class="conge-dates">
                        <label>Du</label>
                        <input type="date" class="date-box" @bind="ligne.DateDebut" @bind:format="yyyy-MM-dd" />
                        <label>au</label>
                        <input type="date" class="date-box" @bind="ligne.DateFin" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="conge-actions">
                        <button class="btn-conge" @onclick="() => Enregistrer(ligne)">Enregistrer</button>

                        @if (!CalendarService.EstRentree(conge.Name))
                        {
                            <button class="btn-conge" @onclick="() => BasculerMasque(ligne)">
                                @(ligne.Masque ? "Réafficher" : "Masquer")
                            </button>
                        }

                        @if (ligne.Id > 0)
                        {
                            <button class="btn-conge btn-conge-reset" @onclick="() => Reinitialiser(ligne)">
                                Rétablir l'officiel
                            </button>
                        }
                    </div>

                    @if (ligne.Id > 0)
                    {
                        <div class="conge-etat">@(ligne.Masque ? "Masqué" : "Corrigé")</div>
                    }
                </div>
            }

            <div class="conges-section-title">Congés ajoutés</div>

            @if (congesAjoutes.Count == 0)
            {
                <div class="conges-vide">Aucun congé ajouté.</div>
            }

            @foreach (var ajout in congesAjoutes)
            {
                var ligne = ajout;

                <div class="conge-row">
                    <input class="conge-nom" @bind="ligne.Nom" />

                    <div class="conge-dates">
                        <label>Du</label>
                        <input type="date" class="date-box" @bind="ligne.DateDebut" @bind:format="yyyy-MM-dd" />
                        <label>au</label>
                        <input type="date" class="date-box" @bind="ligne.DateFin" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="conge-actions">
                        <button class="btn-conge" @onclick="() => Enregistrer(ligne)">Enregistrer</button>
                        <button class="btn-conge btn-conge-reset" @onclick="() => Supprimer(ligne)">Supprimer</button>
                    </div>
                </div>
            }

            <div class="conges-section-title">Ajouter un congé</div>

            <div class="conge-row">
                <input class="conge-nom" @bind="nouveauNom" placeholder="Nom du congé" />

                <div class="conge-dates">
                    <label>Du</label>
                    <input type="date" class="date-box" @bind="nouveauDebut" @bind:format="yyyy-MM-dd" />
                    <label>au</label>
                    <input type="date" class="date-box" @bind="nouveauFin" @bind:format="yyyy-MM-dd" />
                </div>

                <div class="conge-actions">
                    <button class="btn-conge" @onclick="Ajouter"
                            disabled="@string.IsNullOrWhiteSpace(nouveauNom)">Ajouter</button>
                </div>
            </div>
        }

        <button class="btn-account-back" @onclick='() => Nav.NavigateTo("/")'>← Retour au calendrier</button>
    </div>
</div>

@code {
    private List<Holiday> congesOfficiels = new();

    private Dictionary<int, UserConge> corrections = new();

    private List<UserConge> congesAjoutes = new();

    private string   nouveauNom   = "";
    private DateTime nouveauDebut = DateTime.Today;
    private DateTime nouveauFin   = DateTime.Today;

    private bool    chargement = true;
    private string? erreur     = null;

    protected override async Task OnInitializedAsync() => await Recharger();

    private async Task Recharger()
    {
        chargement = true;
        erreur     = null;

        var calendrier = await CalendarSvc.GetCalendarData();

        int anneeCourante = CalendarService.AnneeScolaire(DateTime.Today);

        congesOfficiels = calendrier.Holidays
            .Where(h => h.Id > 0)
            .Where(h => CalendarService.AnneeScolaire(h.StartDate) >= anneeCourante
                     && CalendarService.AnneeScolaire(h.StartDate) <= anneeCourante + 1)
            .OrderBy(h => h.StartDate)
            .ToList();

        var (toutes, erreurChargement) = await Api.GetCongesAsync();
        erreur = erreurChargement;

        corrections   = toutes.Where(c => c.IdCalendrierFk is > 0)
                              .GroupBy(c => c.IdCalendrierFk!.Value)
                              .ToDictionary(g => g.Key, g => g.First());
        congesAjoutes = toutes.Where(c => c.IdCalendrierFk is null or 0).ToList();

        chargement = false;
    }

    private UserConge Ligne(int idCalendrier)
    {
        if (corrections.TryGetValue(idCalendrier, out var existante)) return existante;

        var officiel = congesOfficiels.First(h => h.Id == idCalendrier);
        var ligne = new UserConge
        {
            IdCalendrierFk = idCalendrier,
            Nom            = officiel.Name,
            DateDebut      = officiel.StartDate,
            DateFin        = officiel.EndDate,
        };

        corrections[idCalendrier] = ligne;
        return ligne;
    }

    private async Task Enregistrer(UserConge ligne)
    {
        erreur = null;

        var (ok, message) = await Api.SaveCongeAsync(ligne);
        if (!ok) { erreur = message; return; }

        await Recharger();
    }

    private async Task BasculerMasque(UserConge ligne)
    {
        ligne.Masque = !ligne.Masque;
        await Enregistrer(ligne);
    }

    private async Task Reinitialiser(UserConge ligne)
    {
        erreur = null;

        await Api.DeleteCongeAsync(ligne.Id);
        await Recharger();
    }

    private async Task Supprimer(UserConge ligne)
    {
        erreur = null;

        if (ligne.Id > 0) await Api.DeleteCongeAsync(ligne.Id);
        await Recharger();
    }

    private async Task Ajouter()
    {
        erreur = null;

        var (ok, message) = await Api.SaveCongeAsync(new UserConge
        {
            Nom       = nouveauNom.Trim(),
            DateDebut = nouveauDebut.Date,
            DateFin   = nouveauFin.Date,
        });

        if (!ok) { erreur = message; return; }

        nouveauNom = "";
        await Recharger();
    }
}
