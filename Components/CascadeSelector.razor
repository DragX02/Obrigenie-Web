@* ─────────────────────────────────────────────────────────────────────────────
   CascadeSelector.razor — Composant réutilisable de sélection en cascade.

   Reprend le flux réordonné de la page /test (TestPage.razor) sous forme de
   composant compact, embarquable (ex : panneau latéral de la modale de note) :
     1. Année            → Niveau (tous niveaux ayant des visées)
     2. Cours            → tous les cours enseignés à ce niveau (toutes catégories)
     3. Champ            → table domaine, pour la combinaison cours + niveau
     4. Domaine          → table sous_domaine, optionnel
     5. Compétences, savoirs, S-F → champ competence de la visée
     6. Visées           → NomVisée, filtrées par la compétence choisie —
                           sélection multiple avec recherche (MultiSelectSearch)
     7. Visées à maîtriser → celles des visées retenues (fusionnées, dédoublonnées) —
                           sélection multiple avec recherche également

   Tout ce qui est retenu aux étapes 6 et 7 est remonté au parent et finit dans le
   texte affiché sur la note ; la clé étrangère de la note ne retient que la
   première visée cochée (la table note n'en référence qu'une).

   À chaque changement, OnSelectionChanged est invoqué avec l'état courant afin
   que le parent puisse associer la sélection à une note.
   ───────────────────────────────────────────────────────────────────────────── *@

@inject ApiService Api

<div class="cascade-selector">

    @if (loadError != null)
    {
        <div class="cascade-error">@loadError</div>
    }

    @* Étape 1 : année (niveau) *@
    <div class="cascade-field">
        <label>1. Année</label>
        <SearchableSelect Value="@selectedNiveau"
                          ValueChanged="OnNiveauChanged"
                          Placeholder="-- Choisir une année --"
                          Options="OptionsNiveaux" EmptyValue="" />
    </div>

    @* Étape 2 : cours (tous les cours du niveau, toutes catégories confondues) *@
    @if (!string.IsNullOrEmpty(selectedNiveau))
    {
        <div class="cascade-field">
            <label>2. Cours</label>
            <SearchableSelect Value="@selectedCours"
                              ValueChanged="OnCoursChanged"
                              Placeholder="-- Choisir un cours --"
                              Options="OptionsCours" EmptyValue="" />
        </div>
    }

    @* Sous-sélection langue (LM uniquement) *@
    @if (selectedCours == "LM")
    {
        <div class="cascade-field cascade-field-lm">
            <label>⭐ Langue</label>
            <SearchableSelect Value="@selectedLangue"
                              ValueChanged="OnLangueChanged"
                              Placeholder="-- Quelle langue ? --"
                              Options="OptionsLangues" EmptyValue="" />
        </div>
    }

    @* À partir du champ, tout se complète : taper un nom absent des listes propose de
       l'ajouter, et le bouton ouvre en plus les tables entières aux étapes 5 à 8. *@
    @if (!string.IsNullOrEmpty(selectedCours))
    {
        <div class="cascade-completion">
            <button type="button" class="cascade-elargir" @onclick="BasculerElargir">
                @(elargir ? "▾ Revenir au référentiel du champ" : "▸ Il manque une entrée ? Chercher dans toute la base")
            </button>
            <div class="cascade-elargir-note">
                À partir d'ici, tape un nom : s'il n'existe pas encore, « ＋ Ajouter » le crée.
                @if (elargir)
                {
                    <text>Les étapes 5 à 8 affichent en ce moment les tables entières ; ce qui
                    n'existe pas encore pour ce champ sera rattaché à l'enregistrement.</text>
                }
            </div>
        </div>
    }

    @* Étape 3 : champ (table domaine du référentiel) *@
    @if (!string.IsNullOrEmpty(selectedCours))
    {
        <div class="cascade-field">
            <label>3. Champ</label>
            <SearchableSelect Value="@selectedIdDomaine.ToString()"
                              ValueChanged="OnDomaineChanged"
                              OnCreate="AjouterDomaine"
                              Placeholder="-- Choisir un champ --"
                              Options="OptionsDomaines" EmptyValue="0" />
        </div>
    }

    @* Étape 4 : domaine (table sous_domaine du référentiel), optionnel.
       Affichée même quand la liste est vide, pour pouvoir y ajouter le premier. *@
    @if (selectedIdDomaine > 0)
    {
        <div class="cascade-field">
            <label>4. Domaine <span class="cascade-opt">(optionnel)</span></label>
            <SearchableSelect Value="@selectedIdSousD.ToString()"
                              ValueChanged="OnSousDChanged"
                              OnCreate="AjouterSousDomaine"
                              Placeholder="-- Aucun --"
                              Options="OptionsSousDomaines" EmptyValue="0" />
        </div>
    }

    @* Étape 5 : compétences, savoirs, savoir-faire (champ competence de la visée) *@
    @if (selectedIdDomaine > 0 && (listeVisees.Count > 0 || elargir))
    {
        <div class="cascade-field">
            <label>5. Compétences, savoirs, S-F</label>
            <SearchableSelect Value="@selectedIdCompetence.ToString()"
                              ValueChanged="OnCompetenceChanged"
                              OnCreate="AjouterCompetence"
                              Placeholder="-- Choisir --"
                              Options="OptionsCompetences" EmptyValue="0" />
        </div>
    }

    @* Étape 6 : visées (nom_visee) — sélection multiple avec recherche *@
    @if (selectedIdCompetence > 0)
    {
        <div class="cascade-field">
            <label>6. Visées <span class="cascade-opt">(sélectionne ce qui va dans la note)</span></label>
            <MultiSelectSearch Options="OptionsNomVisees"
                               Selected="@ValeursNomVisees"
                               OnToggle="ToggleNomVisee"
                               OnCreate="AjouterNomVisee"
                               Placeholder="Rechercher un attendu…" />
        </div>
    }

    @* Étape 7 : compétence des visées à maîtriser. Comme à l'étape 5, ce choix ne filtre
       rien : c'est lui qui intitule le bloc des visées à maîtriser dans la note. *@
    @if (selectedIdNomVisees.Count > 0)
    {
        <div class="cascade-field">
            <label>7. Compétences, savoirs, S-F <span class="cascade-opt">(des attendus)</span></label>
            <SearchableSelect Value="@selectedIdCompetenceVm.ToString()"
                              ValueChanged="OnCompetenceVmChanged"
                              OnCreate="AjouterCompetenceVm"
                              Placeholder="-- Choisir --"
                              Options="OptionsCompetences" EmptyValue="0" />
        </div>
    }

    @* Étape 8 : visées à maîtriser des visées retenues — sélection multiple avec recherche *@
    @if (selectedIdNomVisees.Count > 0)
    {
        <div class="cascade-field">
            <label>8. Visées à maîtriser <span class="cascade-opt">(sélectionne ce qui va dans la note)</span></label>
            <MultiSelectSearch Options="OptionsViseesMaitriser"
                               Selected="@ValeursVms"
                               OnToggle="ToggleVm"
                               OnCreate="AjouterViseeMaitriser"
                               Placeholder="Rechercher un attendu…" />
        </div>
    }
</div>

@code {
    // Invoqué à chaque changement de sélection : permet au parent (modale de note)
    // de connaître la visée choisie pour, plus tard, l'associer à la note.
    [Parameter] public EventCallback<CascadeSelection> OnSelectionChanged { get; set; }

    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try { listeNiveaux = await Api.GetNiveauxTousAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        // La table des compétences est chargée d'emblée : l'étape 5 y ajoute
        // Compétences / Savoirs / Savoir-faire même quand le champ ne les propose pas.
        try { toutesCompetences = await Api.GetCompetencesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // ── Mode élargi : listes complètes des tables du référentiel ───────────
    private bool elargir;

    private List<CompetenceRefDto>        toutesCompetences = new();
    private List<NomViseeRefDto>          tousNomVisees     = new();
    private List<ViseesMaitriserRefDto>   toutesVm          = new();

    private async Task BasculerElargir()
    {
        elargir = !elargir;
        if (!elargir || tousNomVisees.Count > 0) return;

        try
        {
            tousNomVisees     = await Api.GetNomViseesRefAsync();
            toutesVm          = await Api.GetToutesViseesMaitriserRefAsync();
        }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // ── Sélections courantes ───────────────────────────────────────────────
    private string selectedNiveau       = "";
    private string selectedCours        = "";
    private string selectedLangue       = "";
    private int    selectedIdDomaine    = 0;
    private int    selectedIdSousD      = 0;
    private int    selectedIdCompetence = 0;

    // Compétence des visées à maîtriser (étape 7) : sert uniquement d'intitulé au bloc
    // correspondant dans la note, comme la compétence de l'étape 5 pour les visées.
    private int    selectedIdCompetenceVm = 0;

    // Étapes 6 et 7 : sélection multiple par cases à cocher.
    // selectedIdVisees est dérivé de selectedIdNomVisees (couple compétence + nom_visee).
    private readonly HashSet<int> selectedIdNomVisees = new();
    private readonly HashSet<int> selectedIdVisees    = new();
    private readonly HashSet<int> selectedIdVms       = new();

    // ── Listes chargées ────────────────────────────────────────────────────
    private List<NiveauDto>             listeNiveaux         = new();
    private List<CoursDto>              listeCours           = new();
    private List<DomaineDto>            domainesFiltres      = new();
    private List<SousDomaineRefDto>     listeSousDomaines    = new();
    private List<ViseeRefDto>           listeVisees          = new();
    private List<ViseesMaitriserRefDto> listeViseesMaitriser = new();

    // ── Options des listes déroulantes cherchables ─────────────────────────
    private static SearchableSelect.SelectOption Opt(string value, string label) => new(value, label);

    private IEnumerable<SearchableSelect.SelectOption> OptionsNiveaux =>
        listeNiveaux.Select(n => Opt(n.CodeNiveau, n.NomNiveau));

    private IEnumerable<SearchableSelect.SelectOption> OptionsCours =>
        listeCours.Select(c => Opt(c.CodeCours, c.NomCours));

    private static readonly SearchableSelect.SelectOption[] OptionsLangues =
    {
        new("English", "English"),
        new("Dutch",   "Dutch"),
        new("German",  "German")
    };

    private IEnumerable<SearchableSelect.SelectOption> OptionsDomaines =>
        domainesFiltres.Select(d => Opt(d.IdDom.ToString(), d.Nom));

    private IEnumerable<SearchableSelect.SelectOption> OptionsSousDomaines =>
        listeSousDomaines.Select(s => Opt(s.IdSousDomaine.ToString(), s.NomComp));

    // En mode élargi, les trois dernières listes viennent des tables complètes plutôt
    // que du seul référentiel du champ choisi. Les entrées déjà rattachées restent en
    // tête pour rester repérables.
    // Trois entrées toujours proposées à l'étape 5, en plus de celles du champ.
    // Elles sont résolues en compétences réelles du référentiel ; celle qui n'existe
    // pas encore dans la table est créée au moment où l'utilisateur la choisit.
    private static readonly string[] CompetencesToujoursProposees =
        { "Compétences", "Savoirs", "Savoir-faire" };

    private IEnumerable<SearchableSelect.SelectOption> OptionsCompetences =>
        Fusionner(
            elargir
                ? Fusionner(ListeCompetences.Select(c => Opt(c.Id.ToString(), c.Nom)),
                            toutesCompetences.OrderBy(c => c.NomCompetence)
                                             .Select(c => Opt(c.IdCompetence.ToString(), c.NomCompetence)))
                : ListeCompetences.Select(c => Opt(c.Id.ToString(), c.Nom)),
            CompetencesToujoursProposees.Select(OptionCompetenceFigee));

    // Option d'une entrée toujours proposée : son identifiant si la table la connaît,
    // sinon une valeur « nouveau:… » qui déclenche sa création à la sélection.
    private SearchableSelect.SelectOption OptionCompetenceFigee(string nom)
    {
        var connue = toutesCompetences.FirstOrDefault(
            c => string.Equals(c.NomCompetence.Trim(), nom, StringComparison.OrdinalIgnoreCase));
        return connue != null ? Opt(connue.IdCompetence.ToString(), connue.NomCompetence)
                              : Opt($"{PrefixeNouveau}{nom}", nom);
    }

    private const string PrefixeNouveau = "nouveau:";

    private IEnumerable<SearchableSelect.SelectOption> OptionsNomVisees =>
        elargir
            ? Fusionner(ListeNomVisees.Select(nv => Opt(nv.Id.ToString(), nv.Nom)),
                        tousNomVisees.OrderBy(nv => nv.NomVisee)
                                     .Select(nv => Opt(nv.IdNomVisee.ToString(), nv.NomVisee)))
            : ListeNomVisees.Select(nv => Opt(nv.Id.ToString(), nv.Nom));

    private IEnumerable<SearchableSelect.SelectOption> OptionsViseesMaitriser =>
        elargir
            ? Fusionner(listeViseesMaitriser.Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser)),
                        toutesVm.OrderBy(vm => vm.NomViseesMaitriser)
                                .Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser)))
            : listeViseesMaitriser.Select(vm => Opt(vm.IdViseesMaitriser.ToString(), vm.NomViseesMaitriser));

    // Concatène deux listes d'options en écartant les doublons de valeur.
    private static IEnumerable<SearchableSelect.SelectOption> Fusionner(
        IEnumerable<SearchableSelect.SelectOption> tete,
        IEnumerable<SearchableSelect.SelectOption> reste)
    {
        var vues = new HashSet<string>();
        foreach (var o in tete.Concat(reste))
            if (vues.Add(o.Value)) yield return o;
    }

    // ── Sélections vues comme des chaînes, pour MultiSelectSearch ──────────
    private IReadOnlyCollection<string> ValeursNomVisees =>
        selectedIdNomVisees.Select(i => i.ToString()).ToList();

    private IReadOnlyCollection<string> ValeursVms =>
        selectedIdVms.Select(i => i.ToString()).ToList();

    // ── Listes dérivées ────────────────────────────────────────────────────
    private IEnumerable<(int Id, string Nom)> ListeCompetences =>
        listeVisees.GroupBy(v => v.IdCompetence)
                   .Select(g => (Id: g.Key, Nom: g.First().NomCompetence))
                   .OrderBy(x => x.Nom);

    private IEnumerable<(int Id, string Nom)> ListeNomVisees =>
        listeVisees.Where(v => v.IdCompetence == selectedIdCompetence)
                   .GroupBy(v => v.IdNomVisee)
                   .Select(g => (Id: g.Key, Nom: g.First().NomVisee))
                   .OrderBy(x => x.Nom);

    // ── Gestionnaires ──────────────────────────────────────────────────────

    private async Task OnNiveauChanged(string? value)
    {
        selectedNiveau = value ?? "";
        ResetFrom(1);
        await ChargerCours();
        await Notify();
    }

    private async Task OnCoursChanged(string? value)
    {
        selectedCours = value ?? "";
        ResetFrom(2);
        await ChargerDomaines();
        await Notify();
    }

    private async Task OnLangueChanged(string? value)
    {
        selectedLangue = value ?? "";
        await Notify();
    }

    private async Task OnDomaineChanged(string? value)
    {
        selectedIdDomaine = int.TryParse(value, out var v) ? v : 0;
        ResetFrom(3);
        if (selectedIdDomaine > 0)
        {
            try { listeSousDomaines = await Api.GetSousDomainesRefAsync(selectedIdDomaine); }
            catch (Exception ex) { loadError = ex.Message; }
            await ChargerVisees();
        }
        await Notify();
    }

    private async Task OnSousDChanged(string? value)
    {
        selectedIdSousD = int.TryParse(value, out var v) ? v : 0;
        ResetFrom(4);
        await ChargerVisees();
        await Notify();
    }

    private async Task OnCompetenceChanged(string? value)
    {
        // Entrée toujours proposée mais absente de la table : on la crée à la volée.
        if (value != null && value.StartsWith(PrefixeNouveau, StringComparison.Ordinal))
        {
            await AjouterCompetence(value[PrefixeNouveau.Length..]);
            return;
        }

        selectedIdCompetence = int.TryParse(value, out var v) ? v : 0;
        ViderVisees();
        await Notify();
    }

    // Étape 7 : compétence qui intitulera le bloc des visées à maîtriser.
    private async Task OnCompetenceVmChanged(string? value)
    {
        if (value != null && value.StartsWith(PrefixeNouveau, StringComparison.Ordinal))
        {
            await AjouterCompetenceVm(value[PrefixeNouveau.Length..]);
            return;
        }

        selectedIdCompetenceVm = int.TryParse(value, out var v) ? v : 0;
        await Notify();
    }

    // ── Ajout d'entrées absentes du référentiel ───────────────────────────
    // Chaque utilisateur peut compléter les tables depuis la cascade : ce qui n'existe
    // nulle part est créé, puis immédiatement sélectionné. Les appels sont rejouables
    // côté serveur, un nom déjà présent rend simplement son identifiant.

    // Année et cours sont des données fixes : la complétion commence au champ.

    // Étape 3 : nouveau champ pour le cours et l'année choisis.
    private async Task AjouterDomaine(string nom)
    {
        if (string.IsNullOrEmpty(selectedCours) || string.IsNullOrEmpty(selectedNiveau)) return;

        var (ok, id, err) = await Api.CreateRefDomaineAsync(nom, selectedCours, selectedNiveau);
        if (!ok || id == 0) { loadError = err ?? "Ajout du champ refusé."; return; }

        await ChargerDomaines();
        await OnDomaineChanged(id.ToString());
    }

    // Étape 4 : nouveau domaine sous le champ choisi.
    private async Task AjouterSousDomaine(string nom)
    {
        if (selectedIdDomaine == 0) return;

        var (ok, id, err) = await Api.CreateRefSousDomaineAsync(nom, selectedIdDomaine);
        if (!ok || id == 0) { loadError = err ?? "Ajout du domaine refusé."; return; }

        try { listeSousDomaines = await Api.GetSousDomainesRefAsync(selectedIdDomaine); }
        catch (Exception ex) { loadError = ex.Message; }

        await OnSousDChanged(id.ToString());
    }

    private async Task AjouterCompetenceVm(string nom)
    {
        var (ok, id, err) = await Api.CreateRefCompetenceAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la compétence refusé."; return; }

        try { toutesCompetences = await Api.GetCompetencesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        selectedIdCompetenceVm = id;
        await Notify();
    }

    private async Task AjouterCompetence(string nom)
    {
        var (ok, id, err) = await Api.CreateRefCompetenceAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la compétence refusé."; return; }

        try { toutesCompetences = await Api.GetCompetencesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        selectedIdCompetence = id;
        ViderVisees();
        await Notify();
    }

    private async Task AjouterNomVisee(string nom)
    {
        var (ok, id, err) = await Api.CreateRefNomViseeAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la visée refusé."; return; }

        // La nouvelle entrée n'appartient à aucun champ : elle doit figurer dans la
        // liste pour être sélectionnable, donc le mode élargi s'active de lui-même.
        elargir = true;
        try { tousNomVisees = await Api.GetNomViseesRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        await ToggleNomVisee(id.ToString());
    }

    private async Task AjouterViseeMaitriser(string nom)
    {
        var (ok, id, err) = await Api.CreateRefViseeMaitriserAsync(nom);
        if (!ok || id == 0) { loadError = err ?? "Ajout de la visée à maîtriser refusé."; return; }

        elargir = true;
        try { toutesVm = await Api.GetToutesViseesMaitriserRefAsync(); }
        catch (Exception ex) { loadError = ex.Message; }

        await ToggleVm(id.ToString());
    }

    // Étape 6 : ajoute / retire une visée. Les visées à maîtriser proposées sont
    // celles de l'ensemble des visées retenues.
    private async Task ToggleNomVisee(string valeur)
    {
        if (!int.TryParse(valeur, out var idNomVisee)) return;
        if (!selectedIdNomVisees.Remove(idNomVisee)) selectedIdNomVisees.Add(idNomVisee);

        // Résoudre les IdVisée correspondants (couple compétence + nom_visee).
        selectedIdVisees.Clear();
        foreach (var id in selectedIdNomVisees)
        {
            var visee = listeVisees.FirstOrDefault(x => x.IdCompetence == selectedIdCompetence
                                                     && x.IdNomVisee   == id);
            if (visee != null) selectedIdVisees.Add(visee.IdVisee);
        }

        await ChargerViseesMaitriser();
        await Notify();
    }

    // Étape 7 : ajoute / retire une visée à maîtriser.
    private async Task ToggleVm(string valeur)
    {
        if (!int.TryParse(valeur, out var idVm)) return;
        if (!selectedIdVms.Remove(idVm)) selectedIdVms.Add(idVm);
        await Notify();
    }

    // ── Helpers ────────────────────────────────────────────────────────────

    private void ResetFrom(int level)
    {
        if (level <= 1) { selectedCours = ""; listeCours.Clear(); selectedLangue = ""; }
        if (level <= 2) { selectedIdDomaine = 0; domainesFiltres.Clear(); }
        if (level <= 3) { selectedIdSousD = 0; listeSousDomaines.Clear(); }
        selectedIdCompetence = 0;
        listeVisees.Clear();
        ViderVisees();
    }

    // Vide les étapes 6 et 7 (visées cochées et visées à maîtriser proposées).
    private void ViderVisees()
    {
        selectedIdCompetenceVm = 0;
        selectedIdNomVisees.Clear();
        selectedIdVisees.Clear();
        selectedIdVms.Clear();
        listeViseesMaitriser.Clear();
    }

    // Charge tous les cours enseignés au niveau choisi, toutes catégories confondues.
    // Le serveur rend la liste déjà fusionnée et dédoublonnée (un cours peut être
    // rattaché à plusieurs catégories) : ce travail se faisait ici, au prix d'un appel
    // par catégorie du niveau.
    private async Task ChargerCours()
    {
        listeCours.Clear();
        if (string.IsNullOrEmpty(selectedNiveau)) return;
        try { listeCours = await Api.GetCoursByNiveauAsync(selectedNiveau); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    private async Task ChargerDomaines()
    {
        domainesFiltres.Clear();
        if (string.IsNullOrEmpty(selectedCours) || string.IsNullOrEmpty(selectedNiveau)) return;
        try { domainesFiltres = await Api.GetDomainesAsync(selectedCours, selectedNiveau); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    private async Task ChargerVisees()
    {
        listeVisees.Clear();
        selectedIdCompetence = 0;
        ViderVisees();
        if (selectedIdDomaine == 0) return;
        try { listeVisees = await Api.GetViseesRefAsync(selectedIdDomaine, selectedIdSousD > 0 ? selectedIdSousD : null); }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // Visées à maîtriser de toutes les visées cochées. Le serveur les fusionne et les
    // dédoublonne en une requête ; la boucle qui interrogeait ici une visée à la fois
    // coûtait un aller-retour par case cochée.
    private async Task ChargerViseesMaitriser()
    {
        try { listeViseesMaitriser = await Api.GetViseesMaitriserParViseesAsync(selectedIdVisees); }
        catch (Exception ex) { loadError = ex.Message; return; }

        // Les cases cochées qui ne sont plus proposées sont abandonnées.
        // En mode élargi, une visée à maîtriser peut venir de la table complète sans être
        // encore reliée : on ne l'abandonne pas, le lien sera créé à l'enregistrement.
        if (elargir) return;

        var proposees = listeViseesMaitriser.Select(vm => vm.IdViseesMaitriser).ToHashSet();
        selectedIdVms.RemoveWhere(id => !proposees.Contains(id));
    }

    // ── Écriture en base des liens manquants ──────────────────────────────

    /// <summary>
    /// Vrai quand la sélection contient des entrées qui n'existent pas encore dans le
    /// référentiel du champ : visée à créer, ou lien visée ↔ visée à maîtriser à créer.
    /// </summary>
    public bool ReferentielAComplete =>
        selectedIdCompetence > 0 &&
        (selectedIdNomVisees.Any(id => ViseeExistante(id) == 0) ||
         (selectedIdVisees.Count > 0 &&
          selectedIdVms.Any(idVm => !listeViseesMaitriser.Any(vm => vm.IdViseesMaitriser == idVm))));

    // Identifiant de la visée reliant le champ courant à ce nom_visee, 0 si elle n'existe pas.
    private int ViseeExistante(int idNomVisee) =>
        listeVisees.FirstOrDefault(v => v.IdCompetence == selectedIdCompetence
                                     && v.IdNomVisee   == idNomVisee)?.IdVisee ?? 0;

    /// <summary>
    /// Crée en base ce qui manque pour que la sélection soit complète : une visée par
    /// nom_visee retenu qui n'en a pas encore pour ce champ, puis les liens vers les
    /// visées à maîtriser retenues. Recharge ensuite les listes et remonte l'état.
    /// Retourne null si tout s'est bien passé, sinon le message d'erreur.
    ///
    /// Le serveur mène la séquence entière dans une transaction. Elle se faisait ici :
    /// une requête par visée à créer, une relecture pour récupérer les identifiants
    /// attribués, puis une requête par lien — et un onglet fermé au milieu laissait des
    /// visées créées sans aucun lien, que rien ne venait rattraper.
    /// </summary>
    public async Task<string?> SynchroniserReferentielAsync()
    {
        if (!ReferentielAComplete) return null;

        var (ok, idVisees, err) = await Api.EnregistrerSelectionRefAsync(
            selectedIdDomaine, selectedIdSousD, selectedIdCompetence,
            selectedIdNomVisees, selectedIdVms);

        if (!ok) return err ?? "Enregistrement du référentiel refusé.";

        // Relecture : les listes affichées doivent contenir les visées qui viennent
        // d'être créées, sans quoi elles resteraient marquées comme manquantes.
        await RechargerViseesDuChamp();

        // Les identifiants rendus par le serveur font foi : ils couvrent aussi les
        // visées créées à l'instant, dans l'ordre des intitulés envoyés.
        selectedIdVisees.Clear();
        foreach (var idVisee in idVisees) selectedIdVisees.Add(idVisee);

        await ChargerViseesMaitriser();
        await Notify();
        return null;
    }

    // Recharge les visées du champ courant.
    private async Task RechargerViseesDuChamp()
    {
        try
        {
            listeVisees = await Api.GetViseesRefAsync(
                selectedIdDomaine, selectedIdSousD > 0 ? selectedIdSousD : null);
        }
        catch (Exception ex) { loadError = ex.Message; }
    }

    // Libellé d'une compétence : depuis les visées du champ, sinon depuis la table
    // complète (entrée choisie hors du référentiel du champ, ou créée à la volée).
    private string? NomCompetenceDe(int idCompetence) =>
        idCompetence == 0 ? null
        : listeVisees.FirstOrDefault(v => v.IdCompetence == idCompetence)?.NomCompetence
          ?? toutesCompetences.FirstOrDefault(c => c.IdCompetence == idCompetence)?.NomCompetence;

    // Libellés des options dont l'identifiant est retenu, dans l'ordre d'affichage.
    private static List<string> LibellesRetenus(
        IEnumerable<SearchableSelect.SelectOption> options, HashSet<int> retenus) =>
        options.Where(o => int.TryParse(o.Value, out var id) && retenus.Contains(id))
               .Select(o => o.Label).ToList();

    // Remonte l'état courant au parent (avec les libellés résolus).
    private async Task Notify()
    {
        if (!OnSelectionChanged.HasDelegate) return;
        await OnSelectionChanged.InvokeAsync(new CascadeSelection
        {
            CodeNiveau      = selectedNiveau,
            NomNiveau       = listeNiveaux.FirstOrDefault(n => n.CodeNiveau == selectedNiveau)?.NomNiveau,
            CodeCours       = selectedCours,
            NomCours        = listeCours.FirstOrDefault(c => c.CodeCours == selectedCours)?.NomCours,
            Langue          = selectedLangue,
            IdDomaine       = selectedIdDomaine,
            NomDomaine      = domainesFiltres.FirstOrDefault(d => d.IdDom == selectedIdDomaine)?.Nom,
            IdSousDomaine   = selectedIdSousD,
            NomSousDomaine  = listeSousDomaines.FirstOrDefault(s => s.IdSousDomaine == selectedIdSousD)?.NomComp,
            IdCompetence    = selectedIdCompetence,
            NomCompetence   = NomCompetenceDe(selectedIdCompetence),
            IdCompetenceVm  = selectedIdCompetenceVm,
            NomCompetenceVm = NomCompetenceDe(selectedIdCompetenceVm),
            // Étapes 6 et 7 : tout ce qui est retenu, dans l'ordre d'affichage des listes.
            // Les libellés viennent des options affichées (référentiel du champ ou table
            // complète), les identifiants de visée des seules visées déjà reliées.
            IdVisees        = selectedIdVisees.ToList(),
            NomVisees       = LibellesRetenus(OptionsNomVisees, selectedIdNomVisees),
            IdsViseesMaitriser  = selectedIdVms.ToList(),
            NomsViseesMaitriser = LibellesRetenus(OptionsViseesMaitriser, selectedIdVms)
        });
    }

    // État complet de la sélection remonté au parent.
    public class CascadeSelection
    {
        public string? CodeNiveau { get; set; }
        public string? NomNiveau { get; set; }
        public string? CodeCours { get; set; }
        public string? NomCours { get; set; }
        public string? Langue { get; set; }
        public int     IdDomaine { get; set; }
        public string? NomDomaine { get; set; }
        public int     IdSousDomaine { get; set; }
        public string? NomSousDomaine { get; set; }
        // Compétence de l'étape 5 : intitule le bloc des visées dans la note.
        public int     IdCompetence { get; set; }
        public string? NomCompetence { get; set; }

        // Compétence de l'étape 7 : intitule le bloc des visées à maîtriser.
        public int     IdCompetenceVm { get; set; }
        public string? NomCompetenceVm { get; set; }

        // Étape 6 : visées cochées (plusieurs possibles), listes parallèles.
        public List<int>    IdVisees  { get; set; } = new();
        public List<string> NomVisees { get; set; } = new();

        // Étape 7 : visées à maîtriser cochées (plusieurs possibles).
        public List<int>    IdsViseesMaitriser  { get; set; } = new();
        public List<string> NomsViseesMaitriser { get; set; } = new();

        // Première visée cochée : c'est elle qui alimente la clé étrangère de la note
        // (la table note ne référence qu'une visée ; le détail complet vit dans le texte).
        public int IdVisee => IdVisees.Count > 0 ? IdVisees[0] : 0;

        // Vrai dès qu'une visée est retenue, sous forme d'identifiant ou de simple
        // intitulé (une entrée choisie hors du référentiel du champ n'a pas encore d'id).
        public bool ADesVisees => IdVisee > 0 || NomVisees.Count > 0;

        /// <summary>
        /// La sélection en texte, une ligne par niveau renseigné :
        ///
        ///     Année : 1ère primaire
        ///     Cours : Français
        ///     Champ : Orienter sa prise de parole, son écoute, sa lecture, son écrit
        ///     Savoir-faire : Assigner un but à sa lecture ou son écoute
        ///     Compétences : Déterminer un but d'écoute selon l'intention précisée
        ///                   Utiliser les termes du support de lecture comme indices
        ///
        /// C'est cette forme qui est figée sur la note ou la préparation de leçon au
        /// moment de l'enregistrement, puis affichée telle quelle à l'écran, à
        /// l'impression et dans le PDF. Elle vit ici, sur la sélection elle-même, pour
        /// que les deux écrans qui l'emploient ne puissent pas en donner deux versions.
        /// </summary>
        public string EnTexte()
        {
            var lignes = new List<string>();

            void Ajouter(string label, string? valeur)
            {
                if (!string.IsNullOrWhiteSpace(valeur)) lignes.Add($"{label} : {valeur}");
            }

            // Intitulé d'un bloc : la compétence choisie, à défaut le libellé générique.
            static string Libelle(string? competence, string defaut) =>
                string.IsNullOrWhiteSpace(competence) ? defaut : competence;

            // Bloc à valeurs multiples : le libellé n'est écrit qu'une fois, les valeurs
            // suivantes sont alignées dessous, sous la première (indentation conservée
            // à l'affichage comme à l'impression).
            void AjouterBloc(string label, IReadOnlyList<string> valeurs)
            {
                if (valeurs.Count == 0) return;
                var marge = new string(' ', label.Length + 3);   // largeur de « label : »
                lignes.Add($"{label} : {valeurs[0]}");
                for (var i = 1; i < valeurs.Count; i++) lignes.Add(marge + valeurs[i]);
            }

            Ajouter("Année", NomNiveau);
            Ajouter("Cours", NomCours);
            Ajouter("Langue", Langue);
            Ajouter("Champ", NomDomaine);
            Ajouter("Domaine", NomSousDomaine);

            // Les compétences choisies ne s'écrivent pas sur une ligne à elles : ce sont
            // elles qui intitulent les blocs qu'elles qualifient (« Savoirs : … » plutôt
            // que « Visée : … »). Sans choix, on retombe sur le libellé générique.
            AjouterBloc(Libelle(NomCompetence, "Visée"), NomVisees);
            AjouterBloc(Libelle(NomCompetenceVm, "Visée à maîtriser"), NomsViseesMaitriser);

            return string.Join("\n", lignes);
        }
    }
}
