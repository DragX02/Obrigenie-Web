@inherits LayoutComponentBase
@implements IDisposable

@inject AuthService Auth
@inject NavigationManager Nav
@inject ApiService Api
@inject ILocalStorageService LocalStorage
@inject LanguageService Lang

<div class="@(isDark ? "dark" : "light")" id="app-root">

    @if (isInitializing)
    {
        <div class="app-loading"></div>
    }
    else if (isLoggedIn && hasAccess)
    {
        @* Overlay fermeture flyout *@
        @if (flyoutOpen)
        {
            <div class="flyout-overlay" @onclick="CloseFlyout"></div>
        }

        @* Overlay fermeture menu utilisateur *@
        @if (userMenuOpen)
        {
            <div class="flyout-overlay" style="z-index:150" @onclick="CloseUserMenu"></div>
        }

        @* ── Flyout sidebar ── *@
        <nav class="flyout @(flyoutOpen ? "flyout-open" : "")">
            <div class="flyout-header">
                <div class="flyout-logo-text">Obrigenie</div>
                <div class="server-badge @(serverOnline ? "badge-online" : "badge-offline")">
                    <span class="status-dot-flyout"></span>
                    <span class="badge-text">@serverStatusText</span>
                    <button class="btn-refresh-status" @onclick="RefreshStatus">↻</button>
                </div>
            </div>

            <div class="flyout-items">
                <a href="/" class="flyout-item" @onclick="CloseFlyout">
                    <span class="flyout-icon">📅</span> @Lang.T("nav.calendar")
                </a>
                <a href="/referentiel" class="flyout-item" @onclick="CloseFlyout">
                    <span class="flyout-icon">📄</span> @Lang.T("nav.referents")
                </a>
                @* Préparations de leçon, au format de la fiche papier *@
                <a href="/lecons" class="flyout-item" @onclick="CloseFlyout">
                    <span class="flyout-icon">📝</span> Mes leçons
                </a>
                @* Corrections personnelles du calendrier des congés scolaires *@
                <a href="/conges" class="flyout-item" @onclick="CloseFlyout">
                    <span class="flyout-icon">🏖️</span> Congés
                </a>
                @if (isAdmin)
                {
                    <a href="/admin" class="flyout-item" @onclick="CloseFlyout">
                        <span class="flyout-icon">🔑</span> @Lang.T("nav.licenses")
                    </a>
                    <a href="/admin-data" class="flyout-item" @onclick="CloseFlyout">
                        <span class="flyout-icon">🗄️</span> @Lang.T("nav.data")
                    </a>
                    <a href="/test" class="flyout-item" @onclick="CloseFlyout">
                        <span class="flyout-icon">🧪</span> @Lang.T("nav.test")
                    </a>
                }
            </div>

            <div class="flyout-footer">
                <button class="btn-theme-toggle" @onclick="ToggleTheme">
                    @(isDark ? "☀️  " + Lang.T("theme.light") : "🌙  " + Lang.T("theme.dark"))
                </button>
                <button class="btn-logout-flyout" @onclick="Logout">
                    🚪  @Lang.T("action.logout")
                </button>
            </div>
        </nav>

        @* ── Zone principale ── *@
        <div class="main-wrapper">
            <div class="top-bar">
                <button class="btn-hamburger" @onclick="ToggleFlyout">☰</button>
                <span class="top-bar-title">Obrigenie</span>

                @* ── Avatar utilisateur ── *@
                <div class="user-menu" style="margin-left:auto; position:relative;">
                    <button class="user-avatar-btn" @onclick="ToggleUserMenu" title="@userEmail">
                        @userInitial
                    </button>

                    @if (userMenuOpen)
                    {
                        <div class="user-dropdown">
                            <div class="user-dropdown-email">@userEmail</div>
                            <a href="/mon-compte" class="user-dropdown-item" @onclick="CloseUserMenu">
                                👤 @Lang.T("action.account")
                            </a>
                            <button class="user-dropdown-item user-dropdown-logout" @onclick="Logout">
                                🚪 @Lang.T("action.logout")
                            </button>
                        </div>
                    }
                </div>
            </div>

            <main class="content-area">
                @Body
            </main>
        </div>
    }
    else
    {
        @Body
    }
</div>

@code {
    private bool   isInitializing = true;
    private bool   flyoutOpen     = false;
    private bool   isDark         = true;
    private bool   isLoggedIn     = false;
    private bool   hasAccess      = false;
    private bool   isAdmin        = false;
    private bool   serverOnline   = false;
    private bool   userMenuOpen   = false;
    private string userEmail      = "";
    private string userInitial    = "U";

    // Clé stockée pour éviter de recalculer à chaque re-render
    private string serverStatusKey = "server.check";
    private string serverStatusText => Lang.T(serverStatusKey);

    protected override async Task OnInitializedAsync()
    {
        isLoggedIn = await Auth.IsLoggedInAsync();

        if (isLoggedIn)
        {
            var role = await Auth.GetRoleAsync();
            isAdmin = role == "ADMIN";

            if (isAdmin)
            {
                hasAccess = true;
            }
            else
            {
                var licenseCode = await LocalStorage.GetItemAsync<string>("licenseCode");
                if (!string.IsNullOrEmpty(licenseCode))
                    hasAccess = await Api.CheckLicenseAsync(licenseCode);

                if (!hasAccess)
                {
                    await LocalStorage.RemoveItemAsync("licenseCode");
                    isInitializing = false;
                    if (!Nav.Uri.Contains("/access-code"))
                        Nav.NavigateTo("/access-code");
                    return;
                }
            }

            // Charge email et initiale
            userEmail   = await Auth.GetEmailAsync() ?? "";
            userInitial = userEmail.Length > 0 ? userEmail[0].ToString().ToUpper() : "U";

            // Initialise la langue depuis localStorage
            await Lang.InitAsync();
            Lang.OnChange += StateHasChanged;

            var savedTheme = await LocalStorage.GetItemAsync<string>("theme");
            isDark = savedTheme != "light";

            serverOnline = await Api.CheckHealthAsync();
            serverStatusKey = serverOnline ? "server.online" : "server.offline";
        }

        isInitializing = false;
    }

    public void Dispose() => Lang.OnChange -= StateHasChanged;

    private void ToggleFlyout()    => flyoutOpen  = !flyoutOpen;
    private void CloseFlyout()     => flyoutOpen  = false;
    private void ToggleUserMenu()  => userMenuOpen = !userMenuOpen;
    private void CloseUserMenu()   => userMenuOpen = false;

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        await LocalStorage.SetItemAsync("theme", isDark ? "dark" : "light");
    }

    private async Task RefreshStatus()
    {
        serverStatusKey = "server.check";
        serverOnline = await Api.CheckHealthAsync();
        serverStatusKey = serverOnline ? "server.online" : "server.offline";
    }

    private async Task Logout()
    {
        await Auth.RemoveTokenAsync();
        flyoutOpen  = false;
        userMenuOpen = false;
        isLoggedIn  = false;
        Nav.NavigateTo("/login");
    }
}
